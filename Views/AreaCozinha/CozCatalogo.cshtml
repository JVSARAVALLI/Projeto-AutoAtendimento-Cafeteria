@{
    ViewData["Title"] = "Catálogo de Produção";
    Layout = "_Layout_Cozinha";
}

<div class="container mt-4">
    <h2><i class="bi bi-book"></i> Catálogo de Produção</h2>
    <p class="text-muted">Gerencie os itens disponíveis para produção e venda no site.</p>

    <div class="table-responsive mt-4">
        <table class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Item</th>
                    <th>Categoria</th>
                    <th>Disponibilidade no Site</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Café Espresso Duplo</td>
                    <td>Bebidas Quentes</td>
                    <td>
                        <span class="badge bg-success">Ativo</span>
                    </td>
                    <td>
                        <!-- Botão para simular a desativação -->
                        <button class="btn btn-sm btn-outline-danger">Desativar</button>
                    </td>
                </tr>
                <tr>
                    <td>Bolo de Cenoura com Chocolate</td>
                    <td>Sobremesas</td>
                    <td>
                        <span class="badge bg-secondary">Desativado</span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-success">Reativar</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>