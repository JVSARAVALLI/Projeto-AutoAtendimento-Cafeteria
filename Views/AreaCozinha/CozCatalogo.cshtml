<div class="cozinha-modal-overlay" id="fichaModalOverlay">
    <div class="cozinha-modal-card">
        <button type="button" class="btn-close-cozinha" onclick="closeFichaModal()">
            <i class="bi bi-x-lg"></i>
        </button>

        <img id="modalImgCoz" src="" class="modal-img-cozinha" alt="Produto">

        <div class="p-4">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="badge bg-dark text-white fw-bold px-3 py-2 rounded-3" id="modalCodeCoz">#CAT-00</span>
                <span class="fs-4 fw-800 text-success" id="modalPriceCoz">R$ 0,00</span>
            </div>

            <h3 class="fw-bold mb-1" id="modalTitleCoz" style="color: var(--mokka-green-dark);">Nome do Produto</h3>
            <p class="text-muted fs-6 mb-3" id="modalDescCoz">Descrição completa...</p>

            <!-- MODO DE PREPARO / FICHA -->
            <div class="info-box-preparo">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="fw-bold text-success"><i class="bi bi-journal-text me-1"></i> Modo de Preparo & Insumos</span>
                    <span class="fw-bold text-muted small" id="modalPrepTimeCoz"><i class="bi bi-clock me-1"></i> Preparo: 0 min</span>
                </div>
                <p class="m-0 text-dark small fw-semibold" id="modalPreparoInstrucoes">
                    Instruções de preparo vão aparecer aqui...
                </p>
            </div>

            <!-- TABELA NUTRICIONAL -->
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-table me-1"></i> Tabela Nutricional (Porção)</h6>
            <div class="nutrition-table">
                <div class="row text-center g-2">
                    <div class="col-3">
                        <span class="d-block text-muted small fw-bold">Calorias</span>
                        <strong class="text-dark fs-6" id="modalNutriCal">0 kcal</strong>
                    </div>
                    <div class="col-3">
                        <span class="d-block text-muted small fw-bold">Carboidratos</span>
                        <strong class="text-dark fs-6" id="modalNutriCarb">0g</strong>
                    </div>
                    <div class="col-3">
                        <span class="d-block text-muted small fw-bold">Proteínas</span>
                        <strong class="text-dark fs-6" id="modalNutriProt">0g</strong>
                    </div>
                    <div class="col-3">
                        <span class="d-block text-muted small fw-bold">Gorduras</span>
                        <strong class="text-dark fs-6" id="modalNutriGord">0g</strong>
                    </div>
                </div>
                <div class="mt-2 pt-2 border-top text-muted small fw-bold text-center">
                    ⚠️ Alergênicos: <span class="text-danger" id="modalAlergenicos">Nenhum</span>
                </div>
            </div>

            <!-- CONTROLE DE DISPONIBILIDADE NA COZINHA -->
            <div class="mt-4 pt-3 border-top d-flex align-items-center justify-content-between">
                <span class="fw-bold text-dark small">Status no Totem:</span>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-success btn-sm active fw-bold">Disponível</button>
                    <button type="button" class="btn btn-outline-warning btn-sm fw-bold">Poucas Unidades</button>
                    <button type="button" class="btn btn-outline-danger btn-sm fw-bold">Esgotado</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openFichaModal(codigo, nome, preco, descricao, imagem, tempo, instrucoes, cal, carb, prot, gord, alergenicos) {
        document.getElementById('modalCodeCoz').innerText = codigo;
        document.getElementById('modalTitleCoz').innerText = nome;
        document.getElementById('modalPriceCoz').innerText = preco;
        document.getElementById('modalDescCoz').innerText = descricao;
        document.getElementById('modalImgCoz').src = imagem;
        document.getElementById('modalPrepTimeCoz').innerHTML = `<i class="bi bi-clock me-1"></i> Preparo: ${tempo}`;
        document.getElementById('modalPreparoInstrucoes').innerText = instrucoes;

        document.getElementById('modalNutriCal').innerText = cal;
        document.getElementById('modalNutriCarb').innerText = carb;
        document.getElementById('modalNutriProt').innerText = prot;
        document.getElementById('modalNutriGord').innerText = gord;
        document.getElementById('modalAlergenicos').innerText = alergenicos;

        document.getElementById('fichaModalOverlay').style.display = 'flex';
    }

    function closeFichaModal() {
        document.getElementById('fichaModalOverlay').style.display = 'none';
    }

    function filterCozinhaCategory(category, evt) {
        const buttons = document.querySelectorAll('.btn-cat-cozinha');
        buttons.forEach(btn => btn.classList.remove('active'));
        if (evt) evt.currentTarget.classList.add('active');

        const items = document.querySelectorAll('.coz-item');
        items.forEach(item => {
            if (category === 'todos' || item.classList.contains(category)) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    }
</script>