@{
    ViewData["Title"] = "Catálogo de Produtos - Cozinha";
}

<style>
    :root {
        --mokka-green-dark: #2E3E26;
        --mokka-green: #718968;
        --mokka-green-light: #E8EFE6;
        --mokka-brown: #A66A38;
        --mokka-brown-dark: #3E2012;
        --mokka-bg: #FAF7F4;
    }

    .kitchen-title {
        color: var(--mokka-green-dark);
        font-weight: 800;
        font-size: 1.8rem;
        letter-spacing: -0.4px;
        margin-bottom: 0.2rem;
    }

    .kitchen-subtitle {
        color: #6C757D;
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 1.8rem;
    }

    /* FILTROS DE CATEGORIA */
    .categories-scroll-cozinha {
        display: flex;
        gap: 0.65rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
        margin-bottom: 2rem;
    }

    .btn-cat-cozinha {
        background-color: #FFFFFF;
        border: 2px solid rgba(113, 137, 104, 0.2);
        color: var(--mokka-green-dark);
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.55rem 1.25rem;
        border-radius: 30px;
        white-space: nowrap;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        box-shadow: 0 2px 8px rgba(46, 62, 38, 0.04);
        cursor: pointer;
    }

    .btn-cat-cozinha:hover,
    .btn-cat-cozinha.active {
        background-color: var(--mokka-green-dark);
        border-color: var(--mokka-green-dark);
        color: #FFFFFF !important;
        box-shadow: 0 6px 16px rgba(46, 62, 38, 0.2);
    }

    /* CARDS DE PRODUTO */
    .card-cozinha-product {
        background: #FFFFFF;
        border-radius: 22px;
        border: 2px solid rgba(113, 137, 104, 0.15);
        box-shadow: 0 8px 24px rgba(46, 62, 38, 0.05);
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        cursor: pointer;
    }

    .card-cozinha-product:hover {
        transform: translateY(-5px);
        box-shadow: 0 14px 32px rgba(46, 62, 38, 0.12);
        border-color: var(--mokka-green);
    }

    .cozinha-img-wrapper {
        position: relative;
        height: 180px;
        width: 100%;
        overflow: hidden;
        background-color: #EFE8E2;
    }

    .cozinha-img-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.35s ease;
    }

    .card-cozinha-product:hover .cozinha-img-wrapper img {
        transform: scale(1.05);
    }

    .badge-code {
        position: absolute;
        top: 12px;
        left: 12px;
        background-color: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(4px);
        color: #FFFFFF;
        font-weight: 800;
        font-size: 0.75rem;
        border-radius: 8px;
        padding: 4px 10px;
        letter-spacing: 0.5px;
    }

    .badge-price-tag {
        position: absolute;
        bottom: 12px;
        right: 12px;
        background-color: rgba(62, 32, 18, 0.9);
        backdrop-filter: blur(4px);
        color: #FFFFFF;
        font-weight: 800;
        font-size: 0.85rem;
        border-radius: 10px;
        padding: 4px 10px;
    }

    .cozinha-card-body {
        padding: 1.25rem 1.35rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .cozinha-card-title {
        font-weight: 800;
        color: var(--mokka-green-dark);
        font-size: 1.1rem;
        margin-bottom: 0.35rem;
    }

    .cozinha-card-desc {
        color: #6C757D;
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.4;
        margin-bottom: 1.2rem;
        flex-grow: 1;
    }

    .cozinha-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.8rem;
        border-top: 1px solid rgba(113, 137, 104, 0.15);
        margin-top: auto;
    }

    .badge-avail {
        background-color: #E8EFE6;
        color: var(--mokka-green-dark);
        font-weight: 800;
        font-size: 0.75rem;
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .badge-low-stock {
        background-color: #FEF3C7;
        color: #92400E;
        font-weight: 800;
        font-size: 0.75rem;
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

    .prep-time {
        font-size: 0.82rem;
        font-weight: 700;
        color: #6C757D;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    /* MODAL DE FICHA TÉCNICA */
    .cozinha-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .cozinha-modal-card {
        background: #FFFFFF;
        border-radius: 28px;
        width: 90%;
        max-width: 680px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 0;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        position: relative;
        animation: popModal 0.25s ease-out;
    }

    @@keyframes popModal {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .modal-img-cozinha {
        width: 100%;
        height: 230px;
        object-fit: cover;
    }

    .btn-close-cozinha {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(255, 255, 255, 0.9);
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .nutrition-table {
        width: 100%;
        background-color: var(--mokka-bg);
        border-radius: 16px;
        padding: 1rem;
        margin-top: 1rem;
    }

    .nutrition-table td {
        padding: 0.4rem 0.8rem;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--mokka-brown-dark);
    }

    .info-box-preparo {
        background-color: #E8EFE6;
        border-left: 4px solid var(--mokka-green-dark);
        border-radius: 12px;
        padding: 0.9rem 1.1rem;
        margin-bottom: 1rem;
    }
</style>

<div class="container-fluid px-0">
    <!-- CABEÇALHO -->
    <h3 class="kitchen-title">
        📖 Catálogo de Produtos (Cozinha)
    </h3>
    <p class="kitchen-subtitle">Toque em qualquer produto para visualizar a ficha técnica, preparo, tabela nutricional e disponibilidade.</p>

    <!-- CATEGORIAS -->
    <div class="categories-scroll-cozinha">
        <button class="btn-cat-cozinha active" onclick="filterCozinhaCategory('todos', event)">
            <i class="bi bi-grid-fill"></i> Todos
        </button>
        <button class="btn-cat-cozinha" onclick="filterCozinhaCategory('combos', event)">
            <i class="bi bi-stars"></i> Combos
        </button>
        <button class="btn-cat-cozinha" onclick="filterCozinhaCategory('quentes', event)">
            <i class="bi bi-cup-hot-fill"></i> Cafés Quentes
        </button>
        <button class="btn-cat-cozinha" onclick="filterCozinhaCategory('gelados', event)">
            <i class="bi bi-cup-straw"></i> Bebidas Geladas
        </button>
        <button class="btn-cat-cozinha" onclick="filterCozinhaCategory('salgados', event)">
            <i class="bi bi-egg-fried"></i> Salgados
        </button>
        <button class="btn-cat-cozinha" onclick="filterCozinhaCategory('sobremesas', event)">
            <i class="bi bi-cake2-fill"></i> Sobremesas
        </button>
    </div>

    <!-- GRID DOS 30 PRODUTOS INTERATIVOS -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">

