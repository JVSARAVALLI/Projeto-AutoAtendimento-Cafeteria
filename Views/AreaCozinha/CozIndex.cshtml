@{
    ViewData["Title"] = "Monitor de Atendimento";
}

<div style="padding: 20px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f6f8; min-height: 100vh;">
    
    <h2 style="font-size: 2.5em; color: #333; margin-bottom: 20px;">Monitor de Pedidos e Alertas</h2>
    
    <!-- Caixa de Alerta (Escondida por padrão, aparece quando há notificação) -->
    <div id="painelAlerta" style="display: none; background-color: #dc3545; color: white; padding: 30px; border-radius: 15px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 6px 20px rgba(220,53,69,0.5); animation: pulsarVermelho 1.5s infinite;">
        
        <div style="font-size: 2em; font-weight: bold; display: flex; align-items: center; gap: 15px;">
            <span>🚨</span> ATENÇÃO: Cliente a solicitar ajuda no Totem!
        </div>
        
        <button onclick="resolverChamada()" style="background: white; color: #dc3545; border: none; padding: 15px 30px; border-radius: 10px; font-weight: bold; font-size: 1.5em; cursor: pointer;">
            ✔️ Assinalar como Resolvido
        </button>
    </div>

    <!-- Restante interface da Cozinha (Fila de pedidos) -->
    <div style="background: #fff; padding: 30px; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
        <h3 style="font-size: 1.8em; color: #333; border-bottom: 2px solid #eee; padding-bottom: 10px;">Fila de Preparação</h3>
        <p style="color: #666; font-size: 1.2em; margin-top: 20px;">Os pedidos confirmados aparecerão aqui...</p>
    </div>
</div>

<style>
    /* Utilizando o duplo arroba para evitar erros de compilação no Razor */
    @@keyframes pulsarVermelho { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.02); } }
</style>

<script>
    // A cada 2 segundos (2000ms), o monitor verifica se alguém clicou no botão do Totem
    setInterval(verificarChamadas, 2000);

    function verificarChamadas() {
        let alerta = localStorage.getItem('alertaAtendimento');
        let painel = document.getElementById('painelAlerta');
        
        if (alerta === 'Pendente') {
            painel.style.display = 'flex';
        } else {
            painel.style.display = 'none';
        }
    }

    function resolverChamada() {
        // Limpa o alerta no Local Storage para que a caixa vermelha desapareça
        localStorage.removeItem('alertaAtendimento');
        
        // Esconde imediatamente a caixa no ecrã
        document.getElementById('painelAlerta').style.display = 'none';
    }
    
    // Executa a verificação imediatamente ao carregar a página da cozinha
    verificarChamadas();
</script>