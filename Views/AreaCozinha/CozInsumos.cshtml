@{
    ViewData["Title"] = "Controle de Insumos";
    Layout = "_Layout_Cozinha";
}

<div class="container mt-4">
    <h2><i class="bi bi-box-seam"></i> Gestão de Insumos</h2>
    
    <div class="table-responsive mt-4">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Insumo (Descrição)</th>
                    <th>Qtd Atual</th>
                    <th>Qtd Ideal</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Grão de Café Arábica (Kg)</td>
                    <td>2</td>
                    <td>10</td>
                    <td><span class="badge bg-danger">Em Falta</span></td>
                </tr>
                <tr>
                    <td>Leite Integral (Litros)</td>
                    <td>15</td>
                    <td>15</td>
                    <td><span class="badge bg-success">Normalizado</span></td>
                </tr>
                <tr>
                    <td>Açúcar Sachê (Caixas)</td>
                    <td>50</td>
                    <td>10</td>
                    <td><span class="badge bg-warning text-dark">Em Excesso</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>