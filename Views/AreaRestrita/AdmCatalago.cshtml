@model List<Projeto_do_semestre.Models.Produto>
@{
    ViewData["Title"] = "Gerenciar Cardápio - Mokka Café";
    Layout = "_Layout_Restrito";
}

<style>
    :root {
        --mokka-green-dark: #2E3E26;
        --mokka-green: #718968;
        --mokka-green-light: #E8EFE6;
        --mokka-brown: #A66A38;
        --mokka-brown-dark: #3E2012;
        --mokka-bg: #FAF7F4;
    }

    .admin-title {
        color: var(--mokka-green-dark);
        font-weight: 800;
        font-size: 1.6rem;
        letter-spacing: -0.4px;
    }

    .mokka-panel {
        background-color: #FFFFFF;
        border-radius: 24px;
        border: 1px solid rgba(113, 137, 104, 0.15);
        box-shadow: 0 8px 24px rgba(46, 62, 38, 0.05);
        padding: 1.6rem;
    }

    .btn-mokka-add {
        background: linear-gradient(135deg, var(--mokka-brown) 0%, var(--mokka-brown-dark) 100%);
        color: #FFFFFF !important;
        font-weight: 800;
        font-size: 0.9rem;
        border: none;
        border-radius: 14px;
        padding: 0.65rem 1.25rem;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 12px rgba(62, 32, 18, 0.2);
    }

    .btn-mokka-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(62, 32, 18, 0.3);
    }

    .mokka-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 0.6rem;
    }

    .mokka-table tbody tr {
        background-color: var(--mokka-bg);
        transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .mokka-table tbody tr:hover {
        background-color: #F2EBE5;
        transform: scale(1.002);
    }

    .mokka-table td, .mokka-table th {
        padding: 0.9rem 1.1rem;
        vertical-align: middle;
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--mokka-brown-dark);
    }

    .mokka-table th {
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        color: #6C757D;
        border: none;
    }

    .mokka-table td:first-child { border-top-left-radius: 16px; border-bottom-left-radius: 16px; }
    .mokka-table td:last-child { border-top-right-radius: 16px; border-bottom-right-radius: 16px; }

    .product-thumb {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        object-fit: cover;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .badge-promo {
        background-color: #FEF3C7;
        color: #92400E;
        font-weight: 800;
        font-size: 0.72rem;
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        border: 1px solid #FDE68A;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .badge-status-on {
        background-color: #E8EFE6;
        color: var(--mokka-green-dark);
        font-weight: 800;
        font-size: 0.72rem;
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        border: 1px solid rgba(113, 137, 104, 0.3);
    }

    .btn-action-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn-edit { background-color: var(--mokka-green-light); color: var(--mokka-green-dark); }
    .btn-edit:hover { background-color: var(--mokka-green); color: #ffffff; }

    .btn-delete { background-color: #FCE8E6; color: #C5221F; }
    .btn-delete:hover { background-color: #C5221F; color: #ffffff; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="admin-title m-0">
        <i class="bi bi-cup-hot-fill me-2"></i> Gerenciamento do Cardápio
    </h3>
    <a asp-controller="AreaRestrita" asp-action="AdmCadastros" class="btn-mokka-add">
        <i class="bi bi-plus-circle-fill"></i>
        <span>Cadastrar Novo Item</span>
    </a>
</div>

<div class="mokka-panel">
    <div class="table-responsive">
        <table class="mokka-table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 70px;">Imagem</th>
                    <th>Nome do Produto</th>
                    <th>Categoria</th>
                    <th>Preço</th>
                    <th>Destaques / Status</th>
                    <th class="text-end" style="width: 140px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var produto in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(produto.Imagem))
                                {
                                    <img src="@produto.Imagem"
                                         alt="@produto.Nome"
                                         class="product-thumb" />
                                }
                                else
                                {
                                    <span>Sem imagem</span>
                                }
                            </td>

                            <td>
                                <div class="fw-bold">@produto.Nome</div>
                            </td>

                            <td>@produto.Categoria</td>

                            <td>
                                @produto.PrecoAtual.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                            </td>

                            <td>
                                @if (produto.Disponivel)
                                {
                                    <span class="badge-status-on">Disponível</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Indisponível</span>
                                }
                            </td>

                            <td class="text-end">
                                <a asp-controller="Produto"
                                   asp-action="Editar"
                                   asp-route-id="@produto.IdProduto"
                                   class="btn-action-icon"
                                   title="Editar">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>

                                <form asp-controller="Produto"
                                      asp-action="Excluir"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@produto.IdProduto" />

                                    <button type="submit"
                                            class="btn-action-icon btn-delete"
                                            title="Excluir"
                                            onclick="return confirm('Deseja realmente excluir este produto?')">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            Nenhum produto cadastrado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>