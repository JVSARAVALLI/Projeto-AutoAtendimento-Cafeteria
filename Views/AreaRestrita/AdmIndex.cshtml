@{
    ViewData["Title"] = "Gestão de Vendas";
}

<div style="padding: 40px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f6f8; min-height: 100vh;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h2 style="font-size: 2.5em; color: #333; margin: 0;">📊 Vendas e Relatórios</h2>
        <button style="background-color: #28a745; color: white; border: none; padding: 12px 25px; border-radius: 8px; font-weight: bold; cursor: pointer;">
            Exportar PDF
        </button>
    </div>

    <!-- Caixa Principal de Relatório -->
    <div style="background: #fff; padding: 40px; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
        <h3 style="color: #555; margin-bottom: 20px;">Resumo do Dia</h3>
        
        <div style="display: flex; gap: 30px; margin-bottom: 40px;">
            <div style="flex: 1; background: #e6f9ed; padding: 20px; border-radius: 10px; border-left: 5px solid #28a745;">
                <span style="color: #28a745; font-weight: bold; text-transform: uppercase; font-size: 0.9em;">Faturação Total</span>
                <div style="font-size: 2.5em; font-weight: bold; color: #333;">R$ 1.240,00</div>
            </div>
            
            <div style="flex: 1; background: #e6f2ff; padding: 20px; border-radius: 10px; border-left: 5px solid #007bff;">
                <span style="color: #007bff; font-weight: bold; text-transform: uppercase; font-size: 0.9em;">Pedidos Realizados</span>
                <div style="font-size: 2.5em; font-weight: bold; color: #333;">84</div>
            </div>
        </div>

        <p style="color: #777;">A integração com os gráficos reais será apresentada aqui...</p>
    </div>
</div>