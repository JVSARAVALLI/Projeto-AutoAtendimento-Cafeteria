@{
    ViewData["Title"] = "Gerenciar Cardápio";
    Layout = "_Layout_Restrito";
}

<style>
    .admin-card {
        background-color: #fff;
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 12px rgba(26, 26, 26, 0.04);
    }

    .btn-mokka {
        background-color: var(--mokka-brown, #aa7946);
        color: #fff;
        font-weight: 600;
        transition: 0.2s;
    }

    .btn-mokka:hover {
        background-color: var(--mokka-brown-dark, #8c6035);
        color: #fff;
    }

    .table-hover tbody tr:hover {
        background-color: var(--admin-bg, #f4f5f0);
    }
    
    .img-thumbnail-custom {
        width: 45px; 
        height: 45px; 
        object-fit: cover; 
        border-radius: 8px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0" style="color: var(--mokka-black, #1a1a1a);">Catálogo de Produtos</h3>
        <p class="text-muted mb-0 mt-1">Gerencie os itens exibidos para os clientes no autoatendimento.</p>
    </div>
    <a asp-controller="AreaRestrita" asp-action="AdmCadastros" class="btn btn-mokka px-4 py-2">
        <i class="bi bi-plus-lg me-2"></i> Adicionar Produto
    </a>
</div>

<div class="admin-card p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" width="80">Imagem</th>
                    <th scope="col">Nome do Produto</th>
                    <th scope="col">Categoria</th>
                    <th scope="col">Preço</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                <!-- Item Falso 1 para visualização -->
                <tr>
                    <td><img src="https://images.unsplash.com/photo-1572442388796-11668a67e53d?w=100&q=80" class="img-thumbnail-custom" alt="Café"></td>
                    <td class="fw-semibold">Cappuccino Mokka Especial</td>
                    <td>Bebidas Quentes</td>
                    <td class="fw-bold" style="color: var(--mokka-brown-dark);">R$ 18,50</td>
                    <td><span class="badge bg-success bg-opacity-10 text-success border border-success">Ativo</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash3"></i></button>
                    </td>
                </tr>

                <!-- Item Falso 2 para visualização -->
                <tr>
                    <td><img src="https://images.unsplash.com/photo-1558403194-611308249627?w=100&q=80" class="img-thumbnail-custom" alt="Croissant"></td>
                    <td class="fw-semibold">Croissant de Amêndoas</td>
                    <td>Salgados & Lanches</td>
                    <td class="fw-bold" style="color: var(--mokka-brown-dark);">R$ 14,00</td>
                    <td><span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Esgotado</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" title="Editar"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash3"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>