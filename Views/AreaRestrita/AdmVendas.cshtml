@{
    ViewData["Title"] = "Controle de Pedidos";
    Layout = "_Layout_Restrito";
}

<style>
    .admin-card {
        background-color: #fff;
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 12px rgba(26, 26, 26, 0.04);
    }
    
    .badge-mokka-warning {
        background-color: #fff3cd;
        color: #856404;
        border: 1px solid #ffeeba;
    }
    
    .badge-mokka-info {
        background-color: var(--mokka-brown, #aa7946);
        color: white;
    }
    
    .badge-mokka-success {
        background-color: var(--mokka-green-dark, #7a8e5f);
        color: white;
    }

    .order-row {
        border-left: 4px solid transparent;
        transition: all 0.2s;
    }
    
    /* Destaque para novos pedidos */
    .order-new {
        border-left-color: var(--mokka-brown, #aa7946);
        background-color: #faf8f5;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0" style="color: var(--mokka-black, #1a1a1a);">Fila de Pedidos</h3>
        <p class="text-muted mb-0 mt-1">Acompanhe e gerencie o status de preparo.</p>
    </div>
    <button class="btn btn-outline-secondary px-3 py-2">
        <i class="bi bi-arrow-clockwise me-2"></i> Atualizar Tela
    </button>
</div>

<!-- Resumo Rápido -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="admin-card p-3 d-flex align-items-center">
            <div class="bg-warning bg-opacity-25 p-3 rounded-3 me-3 text-warning">
                <i class="bi bi-hourglass-split fs-4"></i>
            </div>
            <div>
                <h6 class="text-muted mb-1">Aguardando Preparo</h6>
                <h4 class="fw-bold m-0">3</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card p-3 d-flex align-items-center">
            <div class="p-3 rounded-3 me-3" style="background-color: rgba(170, 121, 70, 0.2); color: var(--mokka-brown);">
                <i class="bi bi-cup-hot fs-4"></i>
            </div>
            <div>
                <h6 class="text-muted mb-1">Em Preparo</h6>
                <h4 class="fw-bold m-0">2</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card p-3 d-flex align-items-center">
            <div class="p-3 rounded-3 me-3" style="background-color: rgba(122, 142, 95, 0.2); color: var(--mokka-green-dark);">
                <i class="bi bi-check2-circle fs-4"></i>
            </div>
            <div>
                <h6 class="text-muted mb-1">Concluídos Hoje</h6>
                <h4 class="fw-bold m-0">48</h4>
            </div>
        </div>
    </div>
</div>

<!-- Lista de Pedidos -->
<div class="admin-card p-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Pedido</th>
                    <th scope="col">Data/Hora</th>
                    <th scope="col">Cliente / Mesa</th>
                    <th scope="col">Itens (Qtd)</th>
                    <th scope="col">Status Atual</th>
                    <th scope="col" class="text-end">Ações Rápidas</th>
                </tr>
            </thead>
            <tbody>
                <!-- Pedido Novo -->
                <tr class="order-row order-new">
                    <td class="fw-bold">#1042</td>
                    <td class="text-muted small">Hoje, 10:45</td>
                    <td class="fw-semibold">Cliente: João S.</td>
                    <td>2 itens</td>
                    <td><span class="badge badge-mokka-warning px-2 py-1">Aguardando</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Ver Detalhes"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm" style="background-color: var(--mokka-brown); color: white;" title="Iniciar Preparo">Preparar</button>
                    </td>
                </tr>

                <!-- Pedido Em Preparo -->
                <tr class="order-row">
                    <td class="fw-bold">#1041</td>
                    <td class="text-muted small">Hoje, 10:40</td>
                    <td class="fw-semibold">Retirada Balcão</td>
                    <td>4 itens</td>
                    <td><span class="badge badge-mokka-info px-2 py-1">Em Preparo</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Ver Detalhes"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm" style="background-color: var(--mokka-green-dark); color: white;" title="Marcar como Pronto">Pronto</button>
                    </td>
                </tr>
                
                <!-- Pedido Concluído -->
                <tr class="order-row opacity-75">
                    <td class="fw-bold">#1040</td>
                    <td class="text-muted small">Hoje, 10:30</td>
                    <td class="fw-semibold">Mesa 04</td>
                    <td>1 item</td>
                    <td><span class="badge badge-mokka-success px-2 py-1">Concluído</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" title="Ver Detalhes"><i class="bi bi-eye"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>