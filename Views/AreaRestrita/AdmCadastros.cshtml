@{
    ViewData["Title"] = "Central de Cadastros";
}

<div style="padding: 40px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f6f8; min-height: 100vh;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <h2 style="font-size: 2.5em; color: #333; margin: 0;">📝 Central de Cadastros</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px;">
        
        <!-- Cadastrar Produtos -->
        <div style="background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.05); text-align: center; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="font-size: 4em; margin-bottom: 15px;">🍔</div>
                <h3 style="font-size: 1.5em; color: #333;">Produtos e Cardápio</h3>
                <p style="color: #666; margin-bottom: 20px;">Adicione novos itens, preços e imagens ao catálogo do Totem.</p>
            </div>
            <!-- Alterado de <button> para <a> -->
            <a href="/AreaRestrita/AdmCardapio" style="display: block; text-decoration: none; background-color: #007bff; color: white; padding: 12px 25px; border-radius: 8px; font-weight: bold; width: 100%; box-sizing: border-box; transition: background 0.2s;">Gerir Produtos</a>
        </div>

        <!-- Cadastrar Funcionários -->
        <div style="background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.05); text-align: center; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="font-size: 4em; margin-bottom: 15px;">👨‍🍳</div>
                <h3 style="font-size: 1.5em; color: #333;">Equipa (Funcionários)</h3>
                <p style="color: #666; margin-bottom: 20px;">Registo de colaboradores, cargos, salários e turnos.</p>
            </div>
            <!-- Alterado de <button> para <a> -->
            <a href="/AreaRestrita/AdmFuncionarios" style="display: block; text-decoration: none; background-color: #17a2b8; color: white; padding: 12px 25px; border-radius: 8px; font-weight: bold; width: 100%; box-sizing: border-box; transition: background 0.2s;">Gerir Equipa</a>
        </div>

        <!-- Cadastrar Usuários -->
        <div style="background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.05); text-align: center; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="font-size: 4em; margin-bottom: 15px;">🔐</div>
                <h3 style="font-size: 1.5em; color: #333;">Usuários do Sistema</h3>
                <p style="color: #666; margin-bottom: 20px;">Criação de acessos, senhas e permissões (Admin / Cozinha).</p>
            </div>
            <!-- Alterado de <button> para <a> -->
            <a href="/AreaRestrita/AdmUsuarios" style="display: block; text-decoration: none; background-color: #6f42c1; color: white; padding: 12px 25px; border-radius: 8px; font-weight: bold; width: 100%; box-sizing: border-box; transition: background 0.2s;">Gerir Acessos</a>
        </div>

    </div>
</div>