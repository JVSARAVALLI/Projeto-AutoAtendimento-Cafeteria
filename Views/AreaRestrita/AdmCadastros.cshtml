@{
    Layout = "_Layout_Restrito";
    ViewData["Title"] = "Cadastrar Produto";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 p-4 pb-0">
        <h4 class="fw-bold m-0" style="color: #3e2723;"><i class="bi bi-plus-circle-fill text-warning me-2"></i>Cadastrar Novo Item no Cardápio</h4>
        <p class="text-muted small mt-1">Preencha as informações do produto que aparecerá no totem de autoatendimento.</p>
    </div>

    <div class="card-body p-4">
        <form asp-controller="AreaRestrita" asp-action="AdmCadastros" method="post">

            <h6 class="fw-bold mb-3" style="color: #4e342e;">Informações Básicas</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Nome do Produto</label>
                    <input type="text" class="form-control" name="Nome" placeholder="Ex: Cappuccino Cremoso" required>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Categoria</label>
                    <select class="form-select" name="Categoria">
                        <option selected disabled>Selecione...</option>
                        <option>Cafés Quentes</option>
                        <option>Bebidas Geladas</option>
                        <option>Salgados / Lanches</option>
                        <option>Doces / Sobremesas</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Preço de Venda</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">R$</span>
                        <input type="text" class="form-control" name="Preco" placeholder="0,00" required>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold mb-3" style="color: #4e342e;">Detalhes e Imagem</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Foto Ilustrativa (URL ou Arquivo)</label>
                    <input type="text" class="form-control" name="Imagem" placeholder="Cole o link da imagem (ex: Unsplash)">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Disponibilidade de Combo</label>
                    <select class="form-select" name="Combo">
                        <option>Disponível como Combo</option>
                        <option>Apenas Item Avulso</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold text-secondary small">Descrição / Ingredientes</label>
                    <textarea class="form-control" name="Descricao" rows="3" placeholder="Descreva os ingredientes ou diferenciais do café..."></textarea>
                </div>
            </div>

            <hr class="my-4 text-muted">

            <div class="d-flex justify-content-end gap-2">
                <button type="reset" class="btn btn-outline-secondary px-4 fw-semibold">Limpar Campos</button>
                <button type="submit" class="btn px-4 fw-bold text-dark" style="background-color: #ffb300;">
                    <i class="bi bi-check-lg me-1"></i> Salvar no Cardápio
                </button>
            </div>
        </form>
    </div>
</div>