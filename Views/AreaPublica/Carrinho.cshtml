@{
    Layout = "_Layout_Publico";
    ViewData["Title"] = "Meu Pedido - Mokka Café";
}

<style>
    :root {
        --mokka-green-dark: #2E3E26;
        --mokka-green: #718968;
        --mokka-green-light: #E8EFE6;
        --mokka-brown: #A66A38;
        --mokka-brown-dark: #3E2012;
        --mokka-bg: #FAF7F4;
    }

    .cart-section {
        max-width: 1050px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
    }

    .cart-title {
        color: var(--mokka-green-dark);
        font-weight: 800;
        font-size: 1.8rem;
        margin-bottom: 1.8rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .cart-card-box {
        background: #FFFFFF;
        border-radius: 24px;
        border: 2px solid rgba(113, 137, 104, 0.15);
        box-shadow: 0 8px 24px rgba(46, 62, 38, 0.05);
        padding: 1.8rem;
        margin-bottom: 1.5rem;
    }

    .cart-item-row {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--mokka-bg);
    }

    .cart-item-row:last-child {
        border-bottom: none;
    }

    .cart-item-thumb {
        width: 72px;
        height: 72px;
        border-radius: 16px;
        object-fit: cover;
    }

    .cart-item-details {
        flex-grow: 1;
    }

    .cart-item-title {
        font-weight: 800;
        color: var(--mokka-green-dark);
        font-size: 1.05rem;
        margin: 0;
    }

    .cart-item-obs {
        font-size: 0.82rem;
        color: var(--mokka-brown);
        font-weight: 700;
        margin-top: 0.2rem;
    }

    .cart-qty-control {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background-color: var(--mokka-bg);
        border-radius: 12px;
        padding: 0.3rem 0.6rem;
    }

    .btn-qty {
        border: none;
        background: #FFFFFF;
        color: var(--mokka-green-dark);
        font-weight: 800;
        font-size: 1.1rem;
        cursor: pointer;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        transition: all 0.15s ease;
    }

    .btn-qty:hover {
        background-color: var(--mokka-green-dark);
        color: #FFFFFF;
    }

    .summary-card {
        background: #FFFFFF;
        border-radius: 24px;
        border: 2px solid rgba(113, 137, 104, 0.15);
        box-shadow: 0 8px 24px rgba(46, 62, 38, 0.05);
        padding: 2rem;
        position: sticky;
        top: 20px;
    }

    .btn-go-payment {
        width: 100%;
        background: linear-gradient(135deg, var(--mokka-brown) 0%, var(--mokka-brown-dark) 100%);
        color: #FFFFFF !important;
        font-weight: 800;
        font-size: 1.05rem;
        border: none;
        border-radius: 16px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 6px 18px rgba(62, 32, 18, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-go-payment:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(62, 32, 18, 0.3);
    }

    /* OVERLAY / MODAIS */
    .mokka-modal-overlay {
        position: fixed;
        top: 0; left: 0;
        width: 100vw; height: 100vh;
        background: rgba(0,0,0,0.65);
        backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 99999;
    }

    .mokka-modal-card {
        background: #FFFFFF;
        border-radius: 28px;
        padding: 2.2rem;
        max-width: 500px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        position: relative;
        animation: modalPop 0.25s ease-out;
    }

    @@keyframes modalPop {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .payment-option-card {
        border: 2px solid rgba(113, 137, 104, 0.2);
        border-radius: 16px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        background-color: var(--mokka-bg);
    }

    .payment-option-card:hover,
    .payment-option-card.active {
        border-color: var(--mokka-green-dark);
        background-color: #FFFFFF;
        box-shadow: 0 4px 14px rgba(46, 62, 38, 0.12);
    }

    .ticket-badge {
        font-size: 2.8rem;
        font-weight: 900;
        color: var(--mokka-brown-dark);
        background-color: var(--mokka-green-light);
        padding: 0.8rem 1.5rem;
        border-radius: 20px;
        display: inline-block;
        letter-spacing: 2px;
        margin: 1rem 0;
        border: 2px dashed var(--mokka-green);
    }

    .timer-btn-badge {
        background-color: rgba(255,255,255,0.25);
        padding: 0.2rem 0.6rem;
        border-radius: 10px;
        font-size: 0.9rem;
        margin-left: 0.4rem;
    }
</style>

<div class="cart-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="cart-title m-0">
            <i class="bi bi-cart-fill text-success"></i> Meu Pedido
        </h2>
        <a asp-controller="AreaPublica" asp-action="Cardapio" class="btn btn-outline-secondary rounded-4 fw-bold">
            ← Continuar Comprando
        </a>
    </div>

    <div class="row g-4">
        <!-- COLUNA DA ESQUERDA: LISTA DE ITENS -->
        <div class="col-12 col-lg-7">
            <div class="cart-card-box">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h5 class="fw-bold m-0" style="color: var(--mokka-green-dark);">Itens Selecionados</h5>
                    <button class="btn btn-sm btn-outline-danger border-0 fw-bold" onclick="clearCart()">
                        <i class="bi bi-trash"></i> Limpar Pedido
                    </button>
                </div>

                <div id="cartItemsContainer">
                    <!-- Gerado via JavaScript dinamicamente -->
                </div>
            </div>
        </div>

        <!-- COLUNA DA DIREITA: RESUMO -->
        <div class="col-12 col-lg-5">
            <div class="summary-card">
                <h4 class="fw-bold mb-3" style="color: var(--mokka-green-dark);">Resumo do Pedido</h4>
                
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted fw-bold">Subtotal (<span id="totalItemsCount">0</span> itens)</span>
                    <span class="fw-bold" id="subtotalVal">R$ 0,00</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-success fw-bold">Desconto Fidelidade</span>
                    <span class="text-success fw-bold" id="discountVal">- R$ 0,00</span>
                </div>

                <hr>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fs-5 fw-bold text-dark">Total</span>
                    <span class="fs-3 fw-bold" id="totalVal" style="color: var(--mokka-brown-dark);">R$ 0,00</span>
                </div>

                <button class="btn-go-payment" id="btnPaymentTrigger" onclick="openPaymentModal()">
                    <span>Ir para o Pagamento</span>
                    <i class="bi bi-credit-card-fill fs-5"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 1: FORMA DE PAGAMENTO -->
<div class="mokka-modal-overlay" id="paymentModalOverlay">
    <div class="mokka-modal-card">
        <button class="btn-close position-absolute top-0 end-0 m-3" onclick="closePaymentModal()"></button>
        
        <h4 class="fw-bold mb-1" style="color: var(--mokka-green-dark);">Forma de Pagamento</h4>
        <p class="text-muted small mb-4">Escolha como deseja realizar o pagamento do seu pedido no Totem:</p>

        <div class="row g-3 mb-4">
            <div class="col-4">
                <div class="payment-option-card active" onclick="selectPayment(this, 'pix')">
                    <i class="bi bi-qr-code-scan fs-2 text-success d-block mb-1"></i>
                    <span class="fw-bold small">PIX Totem</span>
                </div>
            </div>
            <div class="col-4">
                <div class="payment-option-card" onclick="selectPayment(this, 'cartao')">
                    <i class="bi bi-credit-card-fill fs-2 text-primary d-block mb-1"></i>
                    <span class="fw-bold small">Cartão</span>
                </div>
            </div>
            <div class="col-4">
                <div class="payment-option-card" onclick="selectPayment(this, 'balcao')">
                    <i class="bi bi-cash-stack fs-2 text-warning d-block mb-1"></i>
                    <span class="fw-bold small">Balcão</span>
                </div>
            </div>
        </div>

        <button class="btn-go-payment w-100" onclick="confirmPaymentAndFinish()">
            <span>Confirmar e Pagar</span>
            <i class="bi bi-check-circle-fill fs-5"></i>
        </button>
    </div>
</div>

<!-- MODAL 2: SENHA DO PEDIDO COM RETORNO AUTOMÁTICO DE 5 SEGUNDOS -->
<div class="mokka-modal-overlay" id="successOrderModal">
    <div class="mokka-modal-card">
        <div class="text-success fs-1 mb-1">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h3 class="fw-bold m-0" style="color: var(--mokka-green-dark);">Pedido Confirmado!</h3>
        <p class="text-muted small mb-2">Sua comanda já foi enviada para a Cozinha.</p>
        
        <p class="m-0 fw-bold text-uppercase small text-secondary">Senha de Acompanhamento:</p>
        <div class="ticket-badge" id="generatedOrderCode">#1044</div>

        <p class="small text-muted mb-4">Acompanhe a chamada pelo painel do Totem.</p>

        <button class="btn btn-mokka-submit w-100 rounded-4 py-3 fw-bold text-white" style="background: var(--mokka-green-dark);" onclick="redirectToMenu()">
            Voltar ao Menu Principal <span class="timer-btn-badge" id="timerCount">5s</span>
        </button>
    </div>
</div>

<script>
    // DADOS INICIAIS DO CARRINHO (Simulação com estado em memória)
    let cartItems = [
        {
            id: 1,
            nome: 'Combo Manhã Mokka',
            preco: 14.90,
            qtd: 1,
            obs: 'Pão aquecido, Expresso sem açúcar',
            foto: 'https://images.unsplash.com/photo-1517256064527-09c73fc73e38?auto=format&fit=crop&w=600&q=80'
        },
        {
            id: 2,
            nome: 'Combo Tarde Doce',
            preco: 21.50,
            qtd: 1,
            obs: 'Cappuccino com leite de aveia',
            foto: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=600&q=80'
        }
    ];

    let countdownTimer = null;
    let secondsLeft = 5;

    document.addEventListener('DOMContentLoaded', () => {
        renderCart();
    });

    function renderCart() {
        const container = document.getElementById('cartItemsContainer');
        const btnPayment = document.getElementById('btnPaymentTrigger');

        if (!cartItems || cartItems.length === 0) {
            container.innerHTML = `<div class="text-center text-muted py-5 fw-bold">Seu carrinho está vazio.</div>`;
            document.getElementById('subtotalVal').innerText = 'R$ 0,00';
            document.getElementById('totalVal').innerText = 'R$ 0,00';
            document.getElementById('totalItemsCount').innerText = '0';
            btnPayment.disabled = true;
            btnPayment.style.opacity = '0.5';
            return;
        }

        btnPayment.disabled = false;
        btnPayment.style.opacity = '1';

        let html = '';
        let totalVal = 0;
        let totalCount = 0;

        cartItems.forEach((item, index) => {
            const itemSubtotal = item.preco * item.qtd;
            totalVal += itemSubtotal;
            totalCount += item.qtd;

            html += `
                <div class="cart-item-row">
                    <img src="${item.foto}" class="cart-item-thumb" alt="${item.nome}">
                    <div class="cart-item-details">
                        <h6 class="cart-item-title">${item.nome}</h6>
                        <div class="cart-item-obs"><i class="bi bi-sliders me-1"></i>Obs: ${item.obs}</div>
                        <span class="fw-bold text-muted small">R$ ${item.preco.toFixed(2).replace('.', ',')} un.</span>
                    </div>
                    <div class="cart-qty-control">
                        <button class="btn-qty" onclick="changeQty(${index}, -1)">-</button>
                        <span class="fw-bold px-2">${item.qtd}</span>
                        <button class="btn-qty" onclick="changeQty(${index}, 1)">+</button>
                    </div>
                    <span class="fw-bold fs-6 ms-2" style="color: var(--mokka-brown-dark);">R$ ${itemSubtotal.toFixed(2).replace('.', ',')}</span>
                </div>
            `;
        });

        container.innerHTML = html;
        document.getElementById('subtotalVal').innerText = `R$ ${totalVal.toFixed(2).replace('.', ',')}`;
        document.getElementById('totalVal').innerText = `R$ ${totalVal.toFixed(2).replace('.', ',')}`;
        document.getElementById('totalItemsCount').innerText = totalCount;
    }

    // BOTÕES DE + E - FUNCIONANDO
    function changeQty(index, delta) {
        if (cartItems[index]) {
            cartItems[index].qtd += delta;
            if (cartItems[index].qtd <= 0) {
                cartItems.splice(index, 1);
            }
            renderCart();
        }
    }

    function clearCart() {
        cartItems = [];
        renderCart();
    }

    // ABRIR E FECHAR MODAL DE PAGAMENTO
    function openPaymentModal() {
        if (cartItems.length > 0) {
            document.getElementById('paymentModalOverlay').style.display = 'flex';
        }
    }

    function closePaymentModal() {
        document.getElementById('paymentModalOverlay').style.display = 'none';
    }

    function selectPayment(element, type) {
        document.querySelectorAll('.payment-option-card').forEach(card => card.classList.remove('active'));
        element.classList.add('active');
    }

    // CONFIRMAR PAGAMENTO E GERAR SENHA COM TIMER DE 5s
    function confirmPaymentAndFinish() {
        closePaymentModal();

        // Gera código de pedido aleatório
        const randomCode = '#' + Math.floor(1000 + Math.random() * 9000);
        document.getElementById('generatedOrderCode').innerText = randomCode;

        // Exibe modal da senha
        document.getElementById('successOrderModal').style.display = 'flex';

        // Zera o carrinho interno
        cartItems = [];
        renderCart();

        // Inicia temporizador regressivo de 5 segundos
        secondsLeft = 5;
        document.getElementById('timerCount').innerText = secondsLeft + 's';

        clearInterval(countdownTimer);
        countdownTimer = setInterval(() => {
            secondsLeft--;
            document.getElementById('timerCount').innerText = secondsLeft + 's';

            if (secondsLeft <= 0) {
                clearInterval(countdownTimer);
                redirectToMenu();
            }
        }, 1000);
    }

    function redirectToMenu() {
        clearInterval(countdownTimer);
        window.location.href = '/AreaPublica/Cardapio';
    }
</script>