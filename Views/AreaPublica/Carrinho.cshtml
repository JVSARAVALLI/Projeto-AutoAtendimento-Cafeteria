@{
    Layout = "_Layout_Publico";
    ViewData["Title"] = "Meu Pedido - Mokka Café";
}

<style>
    .cart-card {
        border: 2px solid rgba(113, 137, 104, 0.15);
        border-radius: 20px;
        background-color: #FFFFFF;
        box-shadow: 0 4px 12px rgba(46, 62, 38, 0.05);
        transition: all 0.2s ease;
    }

    .btn-qty {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border: 1px solid #D6CEC7;
        background-color: #FAF7F4;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-qty:hover {
        background-color: var(--mokka-green, #718968);
        color: white;
        border-color: var(--mokka-green, #718968);
    }

    .btn-remove {
        color: #C0392B;
        background: none;
        border: none;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .btn-remove:hover {
        text-decoration: underline;
    }

    .summary-card {
        border: 2px solid rgba(113, 137, 104, 0.2);
        border-radius: 24px;
        background-color: #FFFFFF;
        padding: 1.8rem;
        box-shadow: 0 8px 24px rgba(46, 62, 38, 0.08);
    }

    .btn-checkout-final {
        background: linear-gradient(135deg, var(--mokka-brown, #A66A38) 0%, var(--mokka-brown-dark, #3E2012) 100%);
        color: #ffffff !important;
        font-weight: 800;
        border-radius: 16px;
        padding: 1.1rem;
        border: none;
        width: 100%;
        font-size: 1.2rem;
        box-shadow: 0 8px 20px rgba(166, 106, 56, 0.3);
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-checkout-final:hover {
        transform: scale(1.02);
    }

    /* Modal Overlay Nativo */
    .custom-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .custom-modal-card {
        background: #FFFFFF;
        border-radius: 28px;
        width: 90%;
        max-width: 600px;
        padding: 2.2rem;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        position: relative;
        animation: popModal 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes popModal {
        from { transform: scale(0.8); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .payment-option-card {
        border: 2px solid rgba(113, 137, 104, 0.2);
        border-radius: 18px;
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        background-color: #FAF7F4;
    }

    .payment-option-card:hover, .payment-option-card.selected {
        border-color: var(--mokka-green-dark, #2E3E26);
        background-color: rgba(113, 137, 104, 0.15);
    }

    .payment-option-card i {
        font-size: 2.2rem;
        color: var(--mokka-green-dark, #2E3E26);
    }
</style>

<div class="container my-4" style="max-width: 1050px;">
    <h2 class="fw-extrabold mb-4" style="color: var(--mokka-green-dark, #2E3E26); font-weight: 800;">
        <i class="bi bi-cart3"></i> Meu Pedido
    </h2>

    <div class="row g-4">
        <!-- Lista de Itens do Pedido -->
        <div class="col-lg-8">
            <div id="cartItemsContainer">
                <!-- Itens gerados dinamicamente -->
            </div>

            <div class="mt-4 d-flex justify-content-between align-items-center">
                <a asp-controller="AreaPublica" asp-action="Catalogo" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 12px; font-weight: 700;">
                    <i class="bi bi-arrow-left"></i> Continuar Comprando
                </a>
                <button class="btn btn-sm btn-outline-danger" onclick="clearCart()" style="border-radius: 10px; font-weight: 700;">
                    <i class="bi bi-trash"></i> Limpar Pedido
                </button>
            </div>
        </div>

        <!-- Resumo do Pedido -->
        <div class="col-lg-4">
            <div class="summary-card">
                <h4 class="fw-bold mb-3" style="color: var(--mokka-green-dark, #2E3E26);">Resumo do Pedido</h4>
                
                <div class="d-flex justify-content-between mb-2 text-muted">
                    <span id="summaryCount">Subtotal (0 itens)</span>
                    <span id="summarySubtotal" class="fw-bold">R$ 0,00</span>
                </div>
                
                <div class="d-flex justify-content-between mb-3 text-success">
                    <span>Desconto</span>
                    <span class="fw-bold">- R$ 0,00</span>
                </div>

                <hr>

                <div class="d-flex justify-content-between mb-4">
                    <span class="fs-5 fw-bold" style="color: var(--mokka-brown-dark, #3E2012);">Total</span>
                    <span class="fs-4 fw-extrabold" id="summaryTotal" style="color: var(--mokka-brown-dark, #3E2012); font-weight: 800;">R$ 0,00</span>
                </div>

                <button class="btn-checkout-final" onclick="openCheckoutModal()">
                    Finalizar Pedido <i class="bi bi-arrow-right-circle-fill"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL NATIVO DE FINALIZAÇÃO -->
<div class="custom-modal-overlay" id="checkoutModalOverlay">
    <div class="custom-modal-card">
        
        <!-- Etapa 1: Nome e Forma de Pagamento -->
        <div id="stepPayment">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold mb-0" style="color: var(--mokka-green-dark, #2E3E26);">Finalizando seu Pedido</h3>
                <button type="button" class="btn-close" onclick="closeCheckoutModal()"></button>
            </div>

            <!-- Identificação pelo Nome -->
            <div class="mb-4">
                <label class="form-label fw-bold" style="color: var(--mokka-brown-dark, #3E2012);">
                    Como podemos te chamar quando o pedido estiver pronto?
                </label>
                <input type="text" id="clientNameInput" class="form-control form-control-lg fs-5 rounded-3" placeholder="Digite seu primeiro nome (ex: Ana, Carlos)">
            </div>

            <!-- Opções de Pagamento -->
            <div class="mb-3">
                <label class="form-label fw-bold mb-3" style="color: var(--mokka-brown-dark, #3E2012);">
                    Selecione a forma de pagamento:
                </label>
                <div class="row row-cols-3 g-3">
                    <div class="col">
                        <div class="payment-option-card selected" onclick="selectPayment('pix', this)">
                            <i class="bi bi-qr-code-scan mb-2 d-block"></i>
                            <span class="fw-bold">Pix</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="payment-option-card" onclick="selectPayment('credito', this)">
                            <i class="bi bi-credit-card-fill mb-2 d-block"></i>
                            <span class="fw-bold">Crédito</span>
                        </div>
                    </div>
                    <div class="col">
                        <div class="payment-option-card" onclick="selectPayment('debito', this)">
                            <i class="bi bi-credit-card-2-front-fill mb-2 d-block"></i>
                            <span class="fw-bold">Débito</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-light border rounded-3 text-center my-3 p-3" id="paymentInstruction">
                <i class="bi bi-info-circle text-primary me-1"></i> Aponte a câmera para o totem para pagar via Pix.
            </div>

            <button type="button" class="btn btn-lg btn-success w-100 py-3 fw-bold rounded-3 fs-5 mt-2" onclick="processPayment()">
                Confirmar Pagamento e Enviar
            </button>
        </div>

        <!-- Etapa 2: Confirmação do Pedido -->
        <div id="stepSuccess" style="display: none;" class="text-center py-2">
            <div class="mb-3">
                <i class="bi bi-check-circle-fill display-1 text-success"></i>
            </div>
            <h2 class="fw-extrabold" style="color: var(--mokka-green-dark, #2E3E26); font-weight: 800;">
                Pedido Finalizado com Sucesso!
            </h2>
            <p class="fs-5 text-muted mb-2">
                Obrigado, <strong id="displayClientName" style="color: var(--mokka-brown-dark, #3E2012);">Cliente</strong>!
            </p>
            <div class="bg-light p-3 rounded-4 d-inline-block my-3 border">
                <span class="text-uppercase text-muted d-block small fw-bold">Número da sua senha</span>
                <span class="display-3 fw-extrabold" style="color: var(--mokka-brown, #A66A38); font-weight: 800;">#104</span>
            </div>
            <p class="text-muted mb-4">Fique atento ao painel da cozinha. Seu pedido já está sendo preparado!</p>

            <a asp-controller="AreaPublica" asp-action="IndexPublico" class="btn btn-lg w-100 py-3 fw-bold rounded-4 fs-5 text-white" onclick="clearCartAndReset()" style="background-color: var(--mokka-green-dark, #2E3E26);">
                Toque para voltar ao menu principal <i class="bi bi-house-fill ms-2"></i>
            </a>
        </div>

    </div>
</div>

<script>
    function renderCart() {
        const cart = JSON.parse(localStorage.getItem('mokkaCart')) || [];
        const container = document.getElementById('cartItemsContainer');
        container.innerHTML = '';

        if (cart.length === 0) {
            container.innerHTML = `
                <div class="text-center py-5 bg-white rounded-4 border p-4">
                    <i class="bi bi-cart-x display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">Seu carrinho está vazio</h4>
                    <p class="text-muted">Adicione deliciosos cafés no nosso cardápio!</p>
                </div>`;
            updateSummary(0, 0);
            return;
        }

        let subtotal = 0;
        let totalCount = 0;

        cart.forEach((item, index) => {
            const itemTotal = item.price * item.quantity;
            subtotal += itemTotal;
            totalCount += item.quantity;

            container.innerHTML += `
                <div class="cart-card p-3 mb-3 d-flex align-items-center justify-content-between gap-3">
                    <img src="${item.image}" alt="${item.name}" class="rounded-3" style="width: 90px; height: 90px; object-fit: cover;">
                    
                    <div class="flex-grow-1">
                        <h5 class="fw-bold mb-1" style="color: var(--mokka-green-dark, #2E3E26);">${item.name}</h5>
                        <div class="fw-bold text-muted mb-1">R$ ${item.price.toFixed(2).replace('.', ',')}</div>
                        <button class="btn-remove" onclick="removeItem(${index})">
                            <i class="bi bi-trash"></i> Remover
                        </button>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button class="btn-qty" onclick="changeQty(${index}, -1)">-</button>
                        <span class="fw-bold fs-5 px-2">${item.quantity}</span>
                        <button class="btn-qty" onclick="changeQty(${index}, 1)">+</button>
                    </div>

                    <div class="text-end fw-extrabold fs-5" style="min-width: 90px; color: var(--mokka-brown-dark, #3E2012);">
                        R$ ${itemTotal.toFixed(2).replace('.', ',')}
                    </div>
                </div>`;
        });

        updateSummary(totalCount, subtotal);
    }

    function changeQty(index, delta) {
        let cart = JSON.parse(localStorage.getItem('mokkaCart')) || [];
        cart[index].quantity += delta;

        if (cart[index].quantity <= 0) {
            cart.splice(index, 1);
        }

        localStorage.setItem('mokkaCart', JSON.stringify(cart));
        renderCart();
    }

    function removeItem(index) {
        let cart = JSON.parse(localStorage.getItem('mokkaCart')) || [];
        cart.splice(index, 1);
        localStorage.setItem('mokkaCart', JSON.stringify(cart));
        renderCart();
    }

    function clearCart() {
        localStorage.removeItem('mokkaCart');
        renderCart();
    }

    function updateSummary(count, subtotal) {
        document.getElementById('summaryCount').innerText = `Subtotal (${count} itens)`;
        document.getElementById('summarySubtotal').innerText = `R$ ${subtotal.toFixed(2).replace('.', ',')}`;
        document.getElementById('summaryTotal').innerText = `R$ ${subtotal.toFixed(2).replace('.', ',')}`;
    }

    /* Abertura e Fechamento do Modal Nativo */
    function openCheckoutModal() {
        const cart = JSON.parse(localStorage.getItem('mokkaCart')) || [];
        if (cart.length === 0) {
            alert('Seu carrinho está vazio! Adicione produtos antes de finalizar.');
            return;
        }

        document.getElementById('stepPayment').style.display = 'block';
        document.getElementById('stepSuccess').style.display = 'none';
        document.getElementById('checkoutModalOverlay').style.display = 'flex';
    }

    function closeCheckoutModal() {
        document.getElementById('checkoutModalOverlay').style.display = 'none';
    }

    function selectPayment(method, element) {
        document.querySelectorAll('.payment-option-card').forEach(card => card.classList.remove('selected'));
        element.classList.add('selected');

        const instruction = document.getElementById('paymentInstruction');
        if (method === 'pix') {
            instruction.innerHTML = '<i class="bi bi-qr-code-scan text-primary me-1"></i> Aponte a câmera para o totem para pagar via Pix.';
        } else if (method === 'credito') {
            instruction.innerHTML = '<i class="bi bi-credit-card-fill text-primary me-1"></i> Insira ou aproxime seu cartão de Crédito no terminal.';
        } else {
            instruction.innerHTML = '<i class="bi bi-credit-card-2-front-fill text-primary me-1"></i> Insira ou aproxime seu cartão de Débito no terminal.';
        }
    }

    function processPayment() {
        const nameInput = document.getElementById('clientNameInput').value.trim();
        const clientName = nameInput !== '' ? nameInput : 'Cliente';

        document.getElementById('displayClientName').innerText = clientName;

        document.getElementById('stepPayment').style.display = 'none';
        document.getElementById('stepSuccess').style.display = 'block';
    }

    function clearCartAndReset() {
        localStorage.removeItem('mokkaCart');
    }

    document.addEventListener('DOMContentLoaded', renderCart);

    ViewData["Title"] = "Seu Carrinho";
}

<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 800px; margin: 0 auto; padding: 20px;">

    <h2 style="font-size: 2.5em; text-align: center; color: #333;">🛒 O Seu Pedido</h2>

