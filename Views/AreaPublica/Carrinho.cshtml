                    <button onclick="removerDoCarrinho(${index})" style="background-color: #ffc107; color: #000; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 1.2em; font-weight: bold;">
                        Remover
                    </button>
                </div>
            `;
        });

        elementoTotal.innerHTML = "Total: R$ " + total.toFixed(2).replace(".", ",");
    }

    function removerDoCarrinho(index) {
