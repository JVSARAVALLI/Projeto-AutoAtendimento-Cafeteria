@{
    ViewData["Title"] = "Seu Carrinho";
}

<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 800px; margin: 0 auto; padding: 20px;">

    <h2 style="font-size: 2.5em; text-align: center; color: #333;">🛒 O Seu Pedido</h2>

    <div id="itensCarrinho" style="margin-top: 30px; margin-bottom: 30px; background: #fff; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 20px;">
        <!-- Itens injetados via JS -->
    </div>

    <h3 id="totalCarrinho" style="font-size: 2em; color: #28a745; text-align: right; margin-bottom: 40px;">Total: R$ 0.00</h3>

    <hr style="border: 1px solid #ddd; margin: 40px 0;" />

    <!-- Área de Confirmação e Geração de Senha -->
    <div style="background-color: #f8f9fa; padding: 40px 20px; border-radius: 15px; text-align: center; box-shadow: 0 4px 8px rgba(0,0,0,0.05);">
        <h3 style="font-size: 2em; color: #333; margin-bottom: 10px;">Finalizar Pedido</h3>
        <p style="font-size: 1.3em; color: #666; margin-bottom: 30px;">Confirme os seus itens. Uma senha será gerada automaticamente.</p>
        
        <button onclick="finalizarPedido()" style="background-color: #28a745; color: white; border: none; padding: 20px 30px; border-radius: 12px; cursor: pointer; font-weight: bold; font-size: 1.5em; width: 100%; max-width: 400px; box-shadow: 0 6px 12px rgba(40,167,69,0.3);">
            ✔️ Pagar e Gerar Senha
        </button>
        <br />

        <button onclick="cancelarPedidoTotem()" style="background-color: #dc3545; color: white; border: none; padding: 20px 30px; border-radius: 12px; cursor: pointer; font-weight: bold; font-size: 1.5em; width: 100%; max-width: 400px; margin-top: 20px; box-shadow: 0 6px 12px rgba(220,53,69,0.3);">
            ❌ Cancelar e Sair
        </button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        carregarCarrinho();
    });

    function carregarCarrinho() {
        let carrinho = JSON.parse(localStorage.getItem('carrinhoMokka')) || [];
        let container = document.getElementById("itensCarrinho");
        let elementoTotal = document.getElementById("totalCarrinho");
        
        container.innerHTML = "";
        let total = 0;

        if (carrinho.length === 0) {
            container.innerHTML = "<p style='color: #666; font-size: 1.5em; text-align: center;'>O seu carrinho está vazio.</p>";
            elementoTotal.innerHTML = "Total: R$ 0.00";
            return;
        }

        carrinho.forEach((item, index) => {
            let subtotal = item.preco * item.quantidade;
            total += subtotal;

            container.innerHTML += `
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding: 15px 0;">
                    <span style="font-size: 1.5em; color: #333;"><strong>${item.quantidade}x</strong> ${item.nome}</span>
                    <span style="font-size: 1.5em; color: #333;">R$ ${subtotal.toFixed(2)}</span>
                    <button onclick="removerDoCarrinho(${index})" style="background-color: #ffc107; color: #000; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 1.2em; font-weight: bold;">
                        Remover
                    </button>
                </div>
            `;
        });

        elementoTotal.innerHTML = "Total: R$ " + total.toFixed(2).replace(".", ",");
    }

    function removerDoCarrinho(index) {
        let carrinho = JSON.parse(localStorage.getItem('carrinhoMokka')) || [];
        carrinho.splice(index, 1);
        localStorage.setItem('carrinhoMokka', JSON.stringify(carrinho));
        carregarCarrinho();
    }

    function finalizarPedido() {
        let carrinho = JSON.parse(localStorage.getItem('carrinhoMokka')) || [];
        if (carrinho.length === 0) {
            alert("O carrinho está vazio. Volte ao catálogo para adicionar produtos!");
            return;
        }

        // Gera uma senha aleatória entre 100 e 999
        let numeroSenha = Math.floor(Math.random() * 900) + 100;
        
        alert("✅ Pedido Confirmado!\n\nA sua senha é: " + numeroSenha + "\n\nAguarde ser chamado na receção.");
        
        // Limpa a máquina após a compra com sucesso e volta ao Login
        localStorage.removeItem('carrinhoMokka');
        window.location.href = "/AreaPublica/Login"; 
    }

    function cancelarPedidoTotem() {
        // Limpa a máquina caso o cliente desista a meio
        localStorage.removeItem('carrinhoMokka');
        window.location.href = "/AreaPublica/Logout"; 
    }
</script>