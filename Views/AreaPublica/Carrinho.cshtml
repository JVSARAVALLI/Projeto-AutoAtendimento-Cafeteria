    function carregarCarrinho() {
        let carrinho = JSON.parse(localStorage.getItem('carrinhoMokka')) || [];
        let container = document.getElementById("itensCarrinho");
        let elementoTotal = document.getElementById("totalCarrinho");
        
        container.innerHTML = "";
        let total = 0;

        if (carrinho.length === 0) {
            container.innerHTML = "<p style='color: #666; font-size: 1.5em; text-align: center;'>O seu carrinho está vazio.</p>";
            elementoTotal.innerHTML = "Total: R$ 0.00";
            return;
        }

        carrinho.forEach((item, index) => {
            let subtotal = item.preco * item.quantidade;
            total += subtotal;

            container.innerHTML += `
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding: 15px 0;">
