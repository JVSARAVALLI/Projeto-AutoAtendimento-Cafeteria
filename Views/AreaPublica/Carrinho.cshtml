@{
    ViewData["Title"] = "Meu Carrinho";
}

<style>
    /* Estilos específicos do Carrinho integrados com as variáveis do Layout */
    .cart-item {
        background-color: var(--mokka-card, #fcfaf8);
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.04);
        margin-bottom: 15px;
        padding: 15px;
        transition: transform 0.2s;
    }

    .cart-item:hover {
        box-shadow: 0 6px 15px rgba(0,0,0,0.08);
    }

    .cart-item-img {
        border-radius: 10px;
        object-fit: cover;
        width: 100%;
        height: 100px;
    }

    .cart-summary {
        background-color: var(--mokka-card, #fcfaf8);
        border-radius: 16px;
        border: none;
        box-shadow: 0 6px 15px rgba(0,0,0,0.08);
        padding: 25px;
    }

    .btn-mokka {
        background-color: var(--mokka-brown, #aa7946);
        color: #fff;
        font-weight: bold;
        border-radius: 10px;
        transition: all 0.2s;
    }

    .btn-mokka:hover {
        background-color: var(--mokka-brown-dark, #8c6035);
        color: #fff;
    }

    .btn-outline-mokka {
        color: var(--mokka-brown-dark, #8c6035);
        border: 2px solid var(--mokka-brown, #aa7946);
        border-radius: 10px;
        font-weight: 600;
        background: transparent;
    }

    .btn-outline-mokka:hover {
        background-color: var(--mokka-brown, #aa7946);
        color: #fff;
    }

    .qty-input {
        width: 50px;
        text-align: center;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-weight: 600;
    }

    .text-mokka-dark {
        color: var(--mokka-brown-dark, #8c6035);
    }
</style>

<div class="row">
    <div class="col-12">
        <h2 class="section-title">🛒 Meu Carrinho</h2>
    </div>
</div>

<div class="row">
    <!-- Coluna Esquerda: Lista de Produtos -->
    <div class="col-lg-8">
        
        <!-- Item 1 Estático de Exemplo -->
        <div class="cart-item d-flex align-items-center row m-0">
            <div class="col-3 col-md-2 p-0">
                <img src="https://images.unsplash.com/photo-1572442388796-11668a67e53d?w=300&q=80" alt="Café" class="cart-item-img">
            </div>
            <div class="col-9 col-md-10">
                <div class="d-flex justify-content-between align-items-center h-100 ps-3">
                    <div>
                        <h5 class="mb-1 fw-bold">Cappuccino Mokka Especial</h5>
                        <p class="text-muted mb-2 small">Tamanho: Médio | Extra: Leite de Aveia</p>
                        <h5 class="text-mokka-dark fw-bold mb-0">R$ 18,50</h5>
                    </div>
                    <div class="d-flex flex-column align-items-end">
                        <button class="btn btn-sm text-danger mb-3 p-0"><i class="bi bi-trash3"></i> Remover</button>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-sm btn-outline-secondary px-2">-</button>
                            <input type="text" class="qty-input mx-2" value="1" readonly>
                            <button class="btn btn-sm btn-outline-secondary px-2">+</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Item 2 Estático de Exemplo -->
        <div class="cart-item d-flex align-items-center row m-0">
            <div class="col-3 col-md-2 p-0">
                <img src="https://images.unsplash.com/photo-1558403194-611308249627?w=300&q=80" alt="Croissant" class="cart-item-img">
            </div>
            <div class="col-9 col-md-10">
                <div class="d-flex justify-content-between align-items-center h-100 ps-3">
                    <div>
                        <h5 class="mb-1 fw-bold">Croissant de Amêndoas</h5>
                        <p class="text-muted mb-2 small">Tradicional, Aquecido</p>
                        <h5 class="text-mokka-dark fw-bold mb-0">R$ 14,00</h5>
                    </div>
                    <div class="d-flex flex-column align-items-end">
                        <button class="btn btn-sm text-danger mb-3 p-0"><i class="bi bi-trash3"></i> Remover</button>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-sm btn-outline-secondary px-2">-</button>
                            <input type="text" class="qty-input mx-2" value="2" readonly>
                            <button class="btn btn-sm btn-outline-secondary px-2">+</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-4 mb-5">
            <a asp-controller="AreaPublica" asp-action="Catalogo" class="btn btn-outline-mokka px-4 py-2">
                <i class="bi bi-arrow-left me-2"></i> Continuar Comprando
            </a>
        </div>
    </div>

    <!-- Coluna Direita: Resumo do Pedido -->
    <div class="col-lg-4">
        <div class="cart-summary sticky-top" style="top: 100px;">
            <h4 class="fw-bold mb-4">Resumo do Pedido</h4>
            
            <div class="d-flex justify-content-between mb-3 text-muted">
                <span>Subtotal (3 itens)</span>
                <span class="fw-semibold">R$ 46,50</span>
            </div>
            <div class="d-flex justify-content-between mb-3 text-muted">
                <span>Desconto</span>
                <span class="fw-semibold text-success">- R$ 0,00</span>
            </div>
            
            <hr>
            
            <div class="d-flex justify-content-between mb-4">
                <h5 class="fw-bold">Total</h5>
                <h3 class="fw-bold text-mokka-dark mb-0">R$ 46,50</h3>
            </div>
            
            <button class="btn btn-mokka w-100 py-3 fs-5">
                Finalizar Pedido <i class="bi bi-bag-check-fill ms-2"></i>
            </button>
        </div>
    </div>
</div>