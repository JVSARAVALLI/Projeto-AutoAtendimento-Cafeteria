@{
    Layout = "_Layout_Publico";
    ViewData["Title"] = "Como deseja pedir?";
}

<div style="height: calc(100vh - 100px); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">

    <h1 style="font-size: 3em; color: #333; margin-bottom: 50px;">Como deseja continuar?</h1>

    <div style="display: flex; gap: 40px; justify-content: center; width: 100%; max-width: 800px;">

        <!-- Opção 1: Sem Login (Anónimo) -->
        <a href="/AreaPublica/ModoConsumo" style="flex: 1; background-color: #fff; border: 4px solid #28a745; border-radius: 20px; padding: 50px 20px; text-decoration: none; color: #333; box-shadow: 0 10px 20px rgba(0,0,0,0.1); transition: transform 0.2s;">
            <div style="font-size: 5em; margin-bottom: 20px;">🏃</div>
            <h2 style="font-size: 2em; margin: 0; color: #28a745;">Pedido Rápido</h2>
            <p style="font-size: 1.2em; color: #666; margin-top: 15px;">Avançar sem conta (Apenas gera senha)</p>
        </a>

        <!-- Opção 2: Com Conta (Login) -->
        <a href="/AreaPublica/LoginCliente" style="flex: 1; background-color: #28a745; border: 4px solid #28a745; border-radius: 20px; padding: 50px 20px; text-decoration: none; color: white; box-shadow: 0 10px 20px rgba(40,167,69,0.3); transition: transform 0.2s;">
            <div style="font-size: 5em; margin-bottom: 20px;">⭐</div>
            <h2 style="font-size: 2em; margin: 0;">Tenho Conta</h2>
            <p style="font-size: 1.2em; color: #e6ffe6; margin-top: 15px;">Acumular pontos e usar os meus dados</p>
        </a>

    </div>
</div>