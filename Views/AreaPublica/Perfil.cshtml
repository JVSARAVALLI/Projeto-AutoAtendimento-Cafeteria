@{
    ViewData["Title"] = "Menu do Cliente";
}

<div style="text-align: center; padding: 10vh 20px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    
    <h1 style="font-size: 3.5em; margin-bottom: 10px; color: #333;">Olá!</h1>
    <p style="font-size: 1.8em; color: #666; margin-bottom: 50px;">O que deseja fazer hoje?</p>

    <div style="display: flex; flex-direction: column; gap: 25px; max-width: 500px; margin: 0 auto;">
        
        <a href="/AreaPublica/Catalogo" style="background-color: #007bff; color: white; text-decoration: none; padding: 30px; border-radius: 15px; font-size: 1.8em; font-weight: bold; box-shadow: 0 6px 12px rgba(0,123,255,0.3); display: flex; justify-content: center; align-items: center; gap: 15px;">
            <span style="font-size: 1.5em;">🍽️</span> Novo Pedido
        </a>

        <a href="/AreaPublica/Carrinho" style="background-color: #28a745; color: white; text-decoration: none; padding: 30px; border-radius: 15px; font-size: 1.8em; font-weight: bold; box-shadow: 0 6px 12px rgba(40,167,69,0.3); display: flex; justify-content: center; align-items: center; gap: 15px;">
            <span style="font-size: 1.5em;">🛒</span> Ver o Meu Pedido
        </a>

        <button onclick="encerrarSessaoTotem()" style="background-color: #dc3545; color: white; border: none; padding: 30px; border-radius: 15px; font-size: 1.8em; font-weight: bold; cursor: pointer; box-shadow: 0 6px 12px rgba(220,53,69,0.3); display: flex; justify-content: center; align-items: center; gap: 15px; width: 100%; margin-top: 20px;">
            <span style="font-size: 1.5em;">❌</span> Encerrar e Sair
        </button>

    </div>
</div>

<script>
    function encerrarSessaoTotem() {
        localStorage.removeItem('carrinhoMokka');
        // A ação Logout agora redireciona corretamente para a View de Login
        window.location.href = "/AreaPublica/Logout";
    }
</script>