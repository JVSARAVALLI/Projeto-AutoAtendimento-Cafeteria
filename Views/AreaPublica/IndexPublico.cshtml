@{

    Layout = "_Layout_Publico";
    ViewData["Title"] = "Bem-vindo ao Totem";
}

<style>
    /* Estilos da Tela de Descanso do Totem */
    .attract-container {
        min-height: 100vh;
        width: 100vw;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 3rem 1.5rem;
        background: radial-gradient(circle at center, #FAF7F4 0%, #F5F0EB 100%);
        position: relative;
        overflow: hidden;
    }

    .bg-circle-1 {
        position: absolute;
        top: -120px;
        left: -120px;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: rgba(113, 137, 104, 0.12);
        pointer-events: none;
    }

    .bg-circle-2 {
        position: absolute;
        bottom: -100px;
        right: -100px;
        width: 350px;
        height: 350px;
        border-radius: 50%;
        background: rgba(166, 106, 56, 0.1);
        pointer-events: none;
    }

    .brand-header {
        text-align: center;
        z-index: 2;
    }

    .brand-logo-icon {
        width: 70px;
        height: 70px;
        background-color: var(--mokka-green);
        color: #ffffff;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        box-shadow: 0 8px 20px rgba(113, 137, 104, 0.3);
        margin-bottom: 0.75rem;
    }

    .brand-title {
        font-size: 2.8rem;
        font-weight: 800;
        color: var(--mokka-green-dark);
        margin: 0;
        letter-spacing: -0.5px;
    }

    .brand-subtitle {
        font-size: 1rem;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--mokka-brown);
        font-weight: 700;
    }

    .cup-showcase {
        position: relative;
        z-index: 2;
        margin: 1.5rem 0;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .cup-graphic {
        width: 170px;
        height: 230px;
        background: var(--mokka-green);
        border-radius: 12px 12px 50px 50px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 20px 40px rgba(46, 62, 38, 0.2);
        animation: floatCup 4s ease-in-out infinite;
    }

    .cup-lid {
        position: absolute;
        top: -18px;
        width: 185px;
        height: 22px;
        background: var(--mokka-brown-dark);
        border-radius: 8px 8px 3px 3px;
    }

    .cup-badge {
        background: #FAF7F4;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--mokka-brown-dark);
        text-align: center;
    }

    .cup-badge i {
        font-size: 1.6rem;
        color: var(--mokka-brown-dark);
    }

    .cup-badge span {
        font-weight: 800;
        font-size: 0.8rem;
        color: var(--mokka-brown-dark);
        line-height: 1;
    }

    @@keyframes floatCup {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-12px) rotate(-1deg); }
    }

    .action-area {
        width: 100%;
        max-width: 460px;
        text-align: center;
        z-index: 2;
    }

    .welcome-text {
        font-size: 1.25rem;
        color: var(--mokka-brown-dark);
        margin-bottom: 1.5rem;
        font-weight: 600;
    }

    .btn-start-order {
        background: linear-gradient(135deg, var(--mokka-green) 0%, var(--mokka-green-dark) 100%);
        color: #ffffff;
        width: 100%;
        padding: 1.4rem 2rem;
        border-radius: 20px;
        font-size: 1.35rem;
        font-weight: 800;
        border: none;
        box-shadow: 0 10px 25px rgba(46, 62, 38, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        animation: pulseButton 2s infinite;
    }

    .btn-start-order:hover, .btn-start-order:active {
        background: linear-gradient(135deg, var(--mokka-green-dark) 0%, #1A2616 100%);
        color: #ffffff;
        transform: scale(1.02);
    }

    @@keyframes pulseButton {
        0% { box-shadow: 0 0 0 0 rgba(113, 137, 104, 0.5); }
        70% { box-shadow: 0 0 0 18px rgba(113, 137, 104, 0); }
        100% { box-shadow: 0 0 0 0 rgba(113, 137, 104, 0); }
    }

    .touch-hint {
        margin-top: 1rem;
        font-size: 0.85rem;
        color: #8C827A;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
</style>

<div class="attract-container">
    <div class="bg-circle-1"></div>
    <div class="bg-circle-2"></div>

    <div class="brand-header">
        <div class="brand-logo-icon">
            <i class="bi bi-cup-hot-fill"></i>
        </div>
        <h1 class="brand-title">Mokka</h1>
        <span class="brand-subtitle">Café</span>
    </div>

    <div class="cup-showcase">
        <div class="cup-graphic">
            <div class="cup-lid"></div>
            <div class="cup-badge">
                <i class="bi bi-cup-hot-fill"></i>
                <span>Mokka<br><small style="font-size: 0.5rem; letter-spacing: 1px;">CAFÉ</small></span>
            </div>
        </div>
    </div>

    <div class="action-area">
        <p class="welcome-text">O seu café perfeito à distância de um toque.</p>
        
        <!-- Direcionando para a Identificação/Fidelidade -->
        <a asp-controller="AreaPublica" asp-action="Identificacao" class="btn-start-order">
            <span>TOCAR PARA INICIAR</span>
            <i class="bi bi-arrow-right-circle-fill"></i>
        </a>

        <div class="touch-hint">
            <i class="bi bi-hand-index-thumb"></i> Toque na tela para abrir o cardápio
        </div>
    </div>
</div>

    // Removemos o layout para este ecrã ocupar 100% do monitor, sem barras
    Layout = null; 
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <title>Mokka Café - Autoatendimento</title>
    <style>
        body, html { 
            margin: 0; 
            height: 100%; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #8c9c6c; 
            color: white; 
            overflow: hidden; 
        }
        
        /* A área clicável para os clientes (ocupa o ecrã inteiro) */
        .ecra-toque { 
            height: 100vh; 
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
            align-items: center; 
            cursor: pointer; 
            text-decoration: none; 
            color: white; 
            transition: background 0.3s; 
        }
        
        .ecra-toque:active { background-color: #7a885d; }
        
        .logo-gigante { font-size: 8em; margin-bottom: 20px; }
        .titulo { font-size: 4em; font-weight: bold; margin-bottom: 40px; }
        .instrucao { font-size: 2.5em; font-weight: 300; animation: piscar 1.5s infinite; }
        
        /* Uso do duplo arroba (@@) para não dar erro no C# (Razor) */
        @@keyframes piscar { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
        
        /* =========================================================
           BOTÃO SECRETO DOS FUNCIONÁRIOS (Canto inferior direito)
           ========================================================= */
        .area-secreta { 
            position: fixed; 
            bottom: 0; 
            right: 0; 
            width: 120px; 
            height: 120px; 
            z-index: 1000;
            cursor: default; /* Mantém a seta normal para não dar nas vistas */
            /* DICA: Se quiser ver o quadrado para testar, apague as barras (/*) da linha abaixo: */
            /* background-color: rgba(255, 0, 0, 0.3); */
        }
    </style>
</head>
<body>

    <!-- 1. FLUXO DO CLIENTE: Um clique no meio do ecrã leva para a escolha (Tipo de Acesso) -->
    <a href="/AreaPublica/TipoAcesso" class="ecra-toque">
        <div class="logo-gigante">☕</div>
        <div class="titulo">Mokka Café</div>
        <div class="instrucao">👆 Toque no ecrã para iniciar</div>
    </a>

    <!-- 2. FLUXO DA EQUIPA: Clicar no canto inferior direito abre o login -->
    <a href="/AreaPublica/LoginFuncionario" class="area-secreta" title="Área da Equipa"></a>

</body>
</html>
