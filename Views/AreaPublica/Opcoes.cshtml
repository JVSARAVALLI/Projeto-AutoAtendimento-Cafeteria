@{
    Layout = "_Layout_Publico";
    ViewData["Title"] = "Como deseja o seu pedido?";
}

<style>
    .type-card {
        border: 3px solid rgba(113, 137, 104, 0.2);
        border-radius: 28px;
        background-color: var(--mokka-card);
        transition: all 0.3s ease;
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .type-card:hover {
        border-color: var(--mokka-brown);
        transform: scale(1.03);
        box-shadow: 0 16px 32px rgba(46, 62, 38, 0.15);
        color: inherit;
    }

    .big-icon-box {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background-color: rgba(113, 137, 104, 0.15);
        color: var(--mokka-green-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3.8rem;
        margin: 0 auto 1.5rem auto;
    }
</style>

<div class="text-center my-5">
    <h2 class="display-5" style="color: var(--mokka-green-dark); font-weight: 800;">Onde prefere saborear?</h2>
    <p class="text-muted fs-5">Selecione uma opção para abrir o cardápio</p>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4 mx-auto my-4" style="max-width: 800px;">
    <!-- Opção 1: Comer no Local -->
    <div class="col">
        <a asp-controller="AreaPublica" asp-action="Catalogo" class="type-card p-5 text-center">
            <div class="big-icon-box">
                <i class="bi bi-cup-hot-fill"></i>
            </div>
            <h3 class="fw-bold mb-2" style="color: var(--mokka-green-dark);">Comer no Local</h3>
            <p class="text-muted mb-0">Servido na mesa em louça Mokka Café</p>
        </a>
    </div>
</div>

    <!-- Opção 2: Para Levar -->
    <div class="col">
        <a asp-controller="AreaPublica" asp-action="Catalogo" class="type-card p-5 text-center">
            <div class="big-icon-box" style="background-color: rgba(166, 106, 56, 0.15); color: var(--mokka-brown);">
                <i class="bi bi-bag-heart-fill"></i>
            </div>
            <h3 class="fw-bold mb-2" style="color: var(--mokka-brown-dark);">Para Levar</h3>
            <p class="text-muted mb-0">Embalado para a sua viagem ou escritório</p>
        </a>
    </div>
</div>
