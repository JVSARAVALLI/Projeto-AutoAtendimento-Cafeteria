@{
    ViewData["Title"] = "Minha Identificação";
}

<style>
    .identificacao-header {
        margin-bottom: 30px;
        color: var(--mokka-black, #1a1a1a);
    }

    .profile-card {
        background-color: var(--mokka-card, #fff);
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border-top: 5px solid var(--mokka-green, #9ab07a);
        padding: 30px;
        height: 100%;
    }

    .loyalty-card {
        background: linear-gradient(135deg, var(--mokka-brown, #aa7946) 0%, var(--mokka-brown-dark, #8c6035) 100%);
        color: white;
        border-radius: 16px;
        border: none;
        box-shadow: 0 8px 20px rgba(170, 121, 70, 0.3);
        padding: 30px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .btn-mokka {
        background-color: var(--mokka-brown, #aa7946);
        color: white;
        font-weight: bold;
        border-radius: 10px;
        padding: 12px 25px;
        transition: 0.3s;
        border: none;
    }

    .btn-mokka:hover {
        background-color: var(--mokka-brown-dark, #8c6035);
        color: white;
        transform: translateY(-2px);
    }

    .btn-outline-mokka {
        color: var(--mokka-green-dark, #7a8e5f);
        border: 2px solid var(--mokka-green-dark, #7a8e5f);
        background: transparent;
        font-weight: bold;
        border-radius: 10px;
        padding: 12px 25px;
        transition: 0.3s;
    }

    .btn-outline-mokka:hover {
        background-color: var(--mokka-green-dark, #7a8e5f);
        color: white;
    }

    .form-control {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
    }

    .form-control:focus {
        border-color: var(--mokka-green, #9ab07a);
        box-shadow: 0 0 0 0.25rem rgba(154, 176, 122, 0.25);
    }
</style>

<div class="container mt-4 mb-5">
    <div class="identificacao-header text-center">
        <h2 class="fw-bold"><i class="bi bi-person-badge text-muted me-2"></i>Sua Identificação</h2>
        <p class="text-muted">Confirme seus dados para continuar com o seu pedido.</p>
    </div>

    <div class="row g-4">
        <!-- Coluna Esquerda: Dados Cadastrais -->
        <div class="col-lg-7">
            <div class="profile-card">
                <h4 class="fw-bold mb-4" style="color: var(--mokka-green-dark);">Dados Pessoais</h4>
                
                <form>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="form-label text-muted small fw-bold">Nome Completo</label>
                            <input type="text" class="form-control py-2" value="João Silva Carvalho" readonly>
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">E-mail</label>
                            <input type="email" class="form-control py-2" value="joao.silva@email.com" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Telefone</label>
                            <input type="text" class="form-control py-2" value="(11) 98765-4321" readonly>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <button type="button" class="btn btn-link text-muted text-decoration-none me-3">Editar Cadastro</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Coluna Direita: Clube Mokka e Ações -->
        <div class="col-lg-5">
            <div class="loyalty-card">
                <div class="d-flex align-items-center mb-4">
                    <i class="bi bi-star-fill text-warning fs-1 me-3"></i>
                    <div>
                        <h4 class="fw-bold mb-0">Clube Mokka</h4>
                        <span class="opacity-75 small">Membro Ouro</span>
                    </div>
                </div>
                
                <div class="mb-4">
                    <h1 class="display-4 fw-bold mb-0">450 <span class="fs-5 fw-normal">estrelas</span></h1>
                    <p class="opacity-75 mt-1">Faltam apenas 50 estrelas para resgatar um café expresso grátis!</p>
                </div>

                <div class="progress mb-3" style="height: 10px; background-color: rgba(255,255,255,0.2);">
                    <div class="progress-bar bg-warning" role="progressbar" style="width: 90%" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

            </div>
        </div>
    </div>

    <!-- Botões de Ação Final (Ficam abaixo dos cards) -->
    <div class="row mt-5">
        <div class="col-12 d-flex justify-content-between align-items-center border-top pt-4">
            <a asp-controller="AreaPublica" asp-action="Carrinho" class="btn btn-outline-mokka">
                <i class="bi bi-arrow-left me-2"></i> Voltar ao Carrinho
            </a>
            
            <a href="#" class="btn btn-mokka px-5 py-3 fs-5">
                Ir para o Pagamento <i class="bi bi-credit-card ms-2"></i>
            </a>
        </div>
    </div>
</div>