@{
    Layout = "_Layout_Publico";
    ViewData["Title"] = "Programa de Fidelidade - Mokka Café";
}

<style>
    .loyalty-section {
        max-width: 480px;
        margin: 4rem auto;
        padding: 0 1.5rem;
    }

    .loyalty-card-mokka {
        background-color: #FFFFFF;
        border: 2px solid rgba(113, 137, 104, 0.18);
        border-radius: 28px;
        padding: 3rem 2.2rem;
        box-shadow: 0 12px 32px rgba(46, 62, 38, 0.08);
        text-align: center;
    }

    .loyalty-icon-badge {
        width: 64px;
        height: 64px;
        background-color: #F4EBE3;
        color: var(--mokka-brown-dark, #3E2012);
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-bottom: 1.25rem;
    }

    .loyalty-title {
        color: var(--mokka-green-dark, #2E3E26);
        font-weight: 800;
        font-size: 1.8rem;
        margin-bottom: 0.4rem;
        letter-spacing: -0.5px;
    }

    .loyalty-subtitle {
        color: #6C757D;
        font-size: 0.92rem;
        font-weight: 600;
        margin-bottom: 2rem;
        line-height: 1.4;
    }

    .form-control-mokka {
        width: 100%;
        padding: 0.95rem 1.2rem;
        border: 2px solid rgba(113, 137, 104, 0.2);
        border-radius: 16px;
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: 1px;
        background-color: #FAF7F4;
        color: var(--mokka-brown-dark, #3E2012);
        transition: all 0.2s ease;
        margin-bottom: 1.2rem;
    }

    .form-control-mokka:focus {
        outline: none;
        border-color: var(--mokka-green, #718968);
        background-color: #FFFFFF;
        box-shadow: 0 0 0 4px rgba(113, 137, 104, 0.12);
    }

    .btn-mokka-submit {
        width: 100%;
        background: linear-gradient(135deg, var(--mokka-brown, #A66A38) 0%, var(--mokka-brown-dark, #3E2012) 100%);
        color: #FFFFFF !important;
        font-weight: 800;
        font-size: 1rem;
        border: none;
        border-radius: 16px;
        padding: 0.9rem;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 6px 18px rgba(62, 32, 18, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.8rem;
    }

    .btn-mokka-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(62, 32, 18, 0.3);
    }

    .btn-mokka-back {
        width: 100%;
        background-color: #E8EFE6;
        color: var(--mokka-green-dark, #2E3E26) !important;
        font-weight: 700;
        font-size: 0.9rem;
        border: none;
        border-radius: 16px;
        padding: 0.8rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        transition: all 0.2s ease;
    }

    .btn-mokka-back:hover {
        background-color: var(--mokka-green, #718968);
        color: #FFFFFF !important;
    }
</style>

<div class="loyalty-section">
    <div class="loyalty-card-mokka">
        <div class="loyalty-icon-badge">
            <i class="bi bi-person-vcard-fill"></i>
        </div>
        <h2 class="loyalty-title">Programa de Fidelidade</h2>
        <p class="loyalty-subtitle">Insira o seu CPF para acumular pontos e resgatar recompensas exclusivas.</p>

        @if (ViewBag.Erro != null)
        {
            <div class="alert alert-danger border-0 rounded-4 small py-2 px-3 mb-3" role="alert">
                <i class="bi bi-exclamation-circle-fill me-1"></i> @ViewBag.Erro
            </div>
        }

        <form asp-controller="AreaPublica" asp-action="LoginCliente" method="post">
            <input type="text" 
                   id="cpfInput" 
                   name="telefoneOuEmail" 
                   class="form-control-mokka text-center" 
                   placeholder="000.000.000-00" 
                   maxlength="14" 
                   required 
                   autocomplete="off" />

            <button type="submit" class="btn-mokka-submit">
                <span>Confirmar e Avançar</span>
                <i class="bi bi-arrow-right-circle-fill"></i>
            </button>
        </form>

        <a asp-controller="AreaPublica" asp-action="TipoAcesso" class="btn-mokka-back">
            <i class="bi bi-arrow-left"></i>
            <span>Voltar à Escolha</span>
        </a>
    </div>
</div>

<script>
    // Máscara automática de CPF para o Totem
    document.getElementById('cpfInput').addEventListener('input', function (e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length > 11) value = value.slice(0, 11);
        
        value = value.replace(/(\d{3})(\d)/, '$1.$2');
        value = value.replace(/(\d{3})(\d)/, '$1.$2');
        value = value.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
        
        e.target.value = value;
    });
</script>