@{
    Layout = "_Layout_Publico";
    ViewData["Title"] = "Catálogo de Produtos";
}

<main class="container" id="catalogo">
    <h2 class="section-title">Escolha seu Café</h2>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <!-- Item 1 -->
        <div class="col">
            <div class="card card-coffee h-100">
                <img src="https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=500&q=80" class="card-img-top" alt="Expresso">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title fw-bold mb-0">Expresso Tradicional</h5>
                        <span class="badge bg-secondary">Avulso</span>
                    </div>
                    <p class="card-text text-muted mb-2">Um shot clássico e encorpado de café 100% arábica.</p>
                    <div class="mb-4"><span class="nutricional-link">📋 Ver Tabela Nutricional</span></div>
                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <span class="price-tag">R$ 6,50</span>
                        <button class="btn btn-add">Adicionar +</button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Adicione os outros cards aqui seguindo o mesmo padrão -->
    </div>
</main>