                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- BARRA FLUTUANTE DE CHECKOUT -->
<div class="floating-cart-bar">
    <div class="cart-info">
        <div class="cart-badge-count" id="cartCount">0</div>
        <div>
            <div class="cart-total-label">Total do Pedido</div>
            <div class="cart-total-value" id="cartTotal">R$ 0,00</div>
        </div>
    </div>
    <a asp-controller="AreaPublica" asp-action="Carrinho" class="btn-checkout">
        <span>Ver Pedido</span>
        <i class="bi bi-arrow-right-circle-fill"></i>
    </a>
</div>

<!-- MODAL DINÂMICO DE CUSTOMIZAÇÃO -->
<div class="custom-modal-overlay" id="customizeModalOverlay">
    <div class="custom-modal-card">
        <button type="button" class="btn-close-modal" onclick="closeCustomizeModal()">
            <i class="bi bi-x-lg"></i>
        </button>

        <img id="modalImg" src="" class="modal-img-header" alt="Produto">

        <div class="p-4">
            <h3 class="fw-bold mb-1" id="modalTitle" style="color: var(--mokka-green-dark, #2E3E26);">Nome do Produto</h3>
            <p class="text-muted fs-6 mb-2" id="modalDescription">Descrição do produto vai aqui...</p>
            
            <div class="badge bg-light text-dark border p-2 mb-4 fs-6 rounded-3" id="modalNutricional">
                <i class="bi bi-info-circle text-primary me-1"></i> Info: 120 kcal
            </div>

            <!-- OPÇÕES DINÂMICAS -->
            <div id="customizeOptionsSection">
                <h5 class="fw-bold mb-3" style="color: var(--mokka-brown-dark, #3E2012);">Personalize o seu pedido</h5>

                <div id="optionsForDrinks" style="display: none;">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Deseja remover algo?</label>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="removeSugar">Sem Açúcar / Adoçante</label>
                            <input class="form-check-input" type="checkbox" id="removeSugar">
                        </div>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="removeCacao">Sem Cacau / Canela em pó</label>
                            <input class="form-check-input" type="checkbox" id="removeCacao">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small text-uppercase">Adicionar Extras (Opcional)</label>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="addShot">Shot Extra de Expresso (+R$ 3,50)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="addShot" value="3.50" onchange="calculateModalTotal()">
                        </div>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="addChantilly">Chantilly Artesanal (+R$ 2,50)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="addChantilly" value="2.50" onchange="calculateModalTotal()">
                        </div>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="addOatMilk">Trocar Leite por Leite de Aveia (+R$ 2,00)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="addOatMilk" value="2.00" onchange="calculateModalTotal()">
                        </div>
                    </div>
                </div>

                <div id="optionsForFood" style="display: none;">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Preparo</label>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="serveWarm">Servir Quentinho (Aquecido)</label>
                            <input class="form-check-input" type="checkbox" id="serveWarm" checked>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small text-uppercase">Adicionar Acompanhamento</label>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="addExpressoOption">Adicionar Expresso Tradicional (+R$ 6,50)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="addExpressoOption" value="6.50" onchange="calculateModalTotal()">
                        </div>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="addSodaOption">Adicionar Refrigerante / Suco (+R$ 7,50)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="addSodaOption" value="7.50" onchange="calculateModalTotal()">
                        </div>
                    </div>
                </div>

                <div id="optionsForDessert" style="display: none;">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small text-uppercase">Acompanhamentos Especiais</label>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="addIceCream">Bola de Sorvete de Baunilha (+R$ 5,00)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="addIceCream" value="5.00" onchange="calculateModalTotal()">
                        </div>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="addExtraSyrup">Calda Extra de Chocolate / Caramelo (+R$ 3,00)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="addExtraSyrup" value="3.00" onchange="calculateModalTotal()">
                        </div>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="addCoffeeSide">Expresso Acompanhante (+R$ 6,50)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="addCoffeeSide" value="6.50" onchange="calculateModalTotal()">
                        </div>
                    </div>
                </div>

                <div id="optionsForCombos" style="display: none;">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small text-uppercase">Opções do Combo</label>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="upgradeDrink">Upgrade para Bebida Grande (+R$ 4,00)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="upgradeDrink" value="4.00" onchange="calculateModalTotal()">
                        </div>
                        <div class="form-check custom-option-item">
                            <label class="form-check-label fw-semibold" for="addExtraSauce">Adicionar Geléia / Manteiga Extra (+R$ 2,50)</label>
                            <input class="form-check-input extra-option" type="checkbox" id="addExtraSauce" value="2.50" onchange="calculateModalTotal()">
                        </div>
                    </div>
                </div>

            </div>

            <div class="d-flex align-items-center justify-content-between gap-3 pt-3 border-top">
                <div class="d-flex align-items-center gap-2">
                    <button class="btn-qty-modal" onclick="changeModalQty(-1)">-</button>
                    <span class="fw-bold fs-4 px-2" id="modalQty">1</span>
                    <button class="btn-qty-modal" onclick="changeModalQty(1)">+</button>
                </div>

                <button class="btn btn-success flex-grow-1 py-3 fw-bold rounded-4 fs-5" onclick="confirmAddToCart()" style="background-color: var(--mokka-green-dark, #2E3E26); border: none;">
                    Adicionar • <span id="modalTotalPrice">R$ 0,00</span>
                </button>
            </div>
        </div>

    </div>
</div>

<script>
    let currentItem = {
        name: '',
        basePrice: 0.00,
        image: '',
        quantity: 1,
        type: 'bebida'
    };

    function openCustomizeModal(nome, preco, descricao, imagem, nutri, type) {
        currentItem.name = nome;
        currentItem.basePrice = preco;
        currentItem.image = imagem;
        currentItem.quantity = 1;
        currentItem.type = type;

        document.getElementById('modalTitle').innerText = nome;
        document.getElementById('modalDescription').innerText = descricao;
        document.getElementById('modalImg').src = imagem;
        document.getElementById('modalNutricional').innerHTML = `<i class="bi bi-info-circle text-primary me-1"></i> ${nutri}`;
        document.getElementById('modalQty').innerText = '1';

        document.querySelectorAll('.form-check-input').forEach(chk => chk.checked = false);

        document.getElementById('optionsForDrinks').style.display = 'none';
        document.getElementById('optionsForFood').style.display = 'none';
        document.getElementById('optionsForDessert').style.display = 'none';
        document.getElementById('optionsForCombos').style.display = 'none';

        if (type === 'bebida') {
            document.getElementById('optionsForDrinks').style.display = 'block';
        } else if (type === 'comida') {
            document.getElementById('optionsForFood').style.display = 'block';
            document.getElementById('serveWarm').checked = true;
        } else if (type === 'sobremesa') {
            document.getElementById('optionsForDessert').style.display = 'block';
        } else if (type === 'combo') {
            document.getElementById('optionsForCombos').style.display = 'block';
        }

        calculateModalTotal();
        document.getElementById('customizeModalOverlay').style.display = 'flex';
    }

    function closeCustomizeModal() {
        document.getElementById('customizeModalOverlay').style.display = 'none';
    }

    function changeModalQty(delta) {
        currentItem.quantity += delta;
        if (currentItem.quantity < 1) currentItem.quantity = 1;
        document.getElementById('modalQty').innerText = currentItem.quantity;
        calculateModalTotal();
    }

    function calculateModalTotal() {
        let totalPerUnit = currentItem.basePrice;

        document.querySelectorAll('.extra-option:checked').forEach(chk => {
            totalPerUnit += parseFloat(chk.value);
        });

        const finalTotal = totalPerUnit * currentItem.quantity;
        document.getElementById('modalTotalPrice').innerText = 'R$ ' + finalTotal.toFixed(2).replace('.', ',');
    }

    function confirmAddToCart() {
        let finalPriceUnit = currentItem.basePrice;
        let obs = [];

        if (currentItem.type === 'bebida') {
            if (document.getElementById('removeSugar').checked) obs.push("Sem Açúcar");
            if (document.getElementById('removeCacao').checked) obs.push("Sem Cacau");
            if (document.getElementById('addShot').checked) { obs.push("+Shot Expresso"); finalPriceUnit += 3.50; }
            if (document.getElementById('addChantilly').checked) { obs.push("+Chantilly"); finalPriceUnit += 2.50; }
            if (document.getElementById('addOatMilk').checked) { obs.push("+Leite Aveia"); finalPriceUnit += 2.00; }
        } else if (currentItem.type === 'comida') {
            if (document.getElementById('serveWarm').checked) obs.push("Aquecido");
            if (document.getElementById('addExpressoOption').checked) { obs.push("+Expresso"); finalPriceUnit += 6.50; }
            if (document.getElementById('addSodaOption').checked) { obs.push("+Bebida"); finalPriceUnit += 7.50; }
        } else if (currentItem.type === 'sobremesa') {
            if (document.getElementById('addIceCream').checked) { obs.push("+Sorvete"); finalPriceUnit += 5.00; }
            if (document.getElementById('addExtraSyrup').checked) { obs.push("+Calda Extra"); finalPriceUnit += 3.00; }
            if (document.getElementById('addCoffeeSide').checked) { obs.push("+Expresso"); finalPriceUnit += 6.50; }
        } else if (currentItem.type === 'combo') {
            if (document.getElementById('upgradeDrink').checked) { obs.push("+Bebida Grande"); finalPriceUnit += 4.00; }
            if (document.getElementById('addExtraSauce').checked) { obs.push("+Geleia/Manteiga"); finalPriceUnit += 2.50; }
        }

        let displayName = currentItem.name;
        if (obs.length > 0) {
            displayName += ` (${obs.join(', ')})`;
        }

        let cart = JSON.parse(localStorage.getItem('mokkaCart')) || [];
        const existing = cart.find(i => i.name === displayName);

        if (existing) {
            existing.quantity += currentItem.quantity;
        } else {
            cart.push({
                name: displayName,
                price: finalPriceUnit,
                image: currentItem.image,
                quantity: currentItem.quantity
            });
        }

        localStorage.setItem('mokkaCart', JSON.stringify(cart));
        updateFloatingBar();
        closeCustomizeModal();
    }

    function updateFloatingBar() {
        const cart = JSON.parse(localStorage.getItem('mokkaCart')) || [];
        let totalCount = 0;
        let totalPrice = 0.00;

        cart.forEach(item => {
            totalCount += item.quantity;
            totalPrice += item.price * item.quantity;
        });

        const countBadge = document.getElementById('cartCount');
        const totalText = document.getElementById('cartTotal');

        if (countBadge && totalText) {
            countBadge.innerText = totalCount;
            totalText.innerText = 'R$ ' + totalPrice.toFixed(2).replace('.', ',');
        }
    }

    function filterCategory(category, evt) {
        const buttons = document.querySelectorAll('.btn-category');
        buttons.forEach(btn => btn.classList.remove('active'));
        if (evt) evt.currentTarget.classList.add('active');

        const items = document.querySelectorAll('.product-item');
        items.forEach(item => {
            if (category === 'todos' || item.classList.contains(category)) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    }

    document.addEventListener('DOMContentLoaded', updateFloatingBar);
</script>