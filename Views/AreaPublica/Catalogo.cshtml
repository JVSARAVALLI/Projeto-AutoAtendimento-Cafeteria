@{
    Layout = "_Layout_Publico";
    ViewData["Title"] = "Cardápio - Mokka Café";
}

<style>
    .catalog-wrapper {
        padding-bottom: 120px;
    }

    .catalog-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-weight: 800;
        color: var(--mokka-green-dark, #2E3E26);
        font-size: 2.2rem;
        letter-spacing: -0.5px;
        margin-bottom: 0.25rem;
    }

    .section-subtitle {
        color: var(--mokka-brown, #A66A38);
        font-size: 1.05rem;
        font-weight: 600;
    }

    .categories-scroll {
        display: flex;
        gap: 0.75rem;
        overflow-x: auto;
        padding: 0.5rem 0 1.5rem 0;
        scrollbar-width: none;
    }

    .categories-scroll::-webkit-scrollbar {
        display: none;
    }

    .btn-category {
        background-color: #FAF7F4;
        color: var(--mokka-brown-dark, #3E2012);
        border: 2px solid rgba(113, 137, 104, 0.2);
        border-radius: 50px;
        padding: 0.6rem 1.4rem;
        font-weight: 700;
        font-size: 0.95rem;
        white-space: nowrap;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

    .btn-category.active, .btn-category:hover {
        background-color: var(--mokka-green-dark, #2E3E26);
        color: #ffffff;
        border-color: var(--mokka-green-dark, #2E3E26);
        box-shadow: 0 4px 12px rgba(46, 62, 38, 0.2);
    }

    .card-coffee {
        border: 2px solid rgba(113, 137, 104, 0.15) !important;
        border-radius: 24px !important;
        box-shadow: 0 8px 24px rgba(46, 62, 38, 0.06) !important;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        background-color: #FFFFFF !important;
        overflow: hidden;
        cursor: pointer;
    }

    .card-coffee:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 32px rgba(46, 62, 38, 0.14) !important;
        border-color: var(--mokka-green, #718968) !important;
    }

    .card-img-container {
        position: relative;
        height: 190px;
        overflow: hidden;
    }

    .card-img-top {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .card-coffee:hover .card-img-top {
        transform: scale(1.05);
    }

    .badge-category {
        position: absolute;
        top: 12px;
        right: 12px;
        background-color: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(4px);
        color: var(--mokka-green-dark, #2E3E26);
        font-weight: 800;
        font-size: 0.75rem;
        border-radius: 30px;
        padding: 6px 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .card-title {
        color: var(--mokka-green-dark, #2E3E26);
        font-size: 1.2rem;
        font-weight: 800;
    }

    .price-tag {
        color: var(--mokka-brown-dark, #3E2012);
        font-size: 1.4rem;
        font-weight: 800;
    }

    .btn-add {
        background: linear-gradient(135deg, var(--mokka-brown, #A66A38) 0%, var(--mokka-brown-dark, #3E2012) 100%);
        color: #ffffff !important;
        font-weight: 700;
        border: none !important;
        border-radius: 14px !important;
        padding: 10px 18px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(166, 106, 56, 0.25);
    }

    .floating-cart-bar {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: 92%;
        max-width: 900px;
        background: var(--mokka-green-dark, #2E3E26);
        color: #ffffff;
        border-radius: 24px;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 12px 32px rgba(46, 62, 38, 0.35);
        z-index: 1000;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .cart-info {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .cart-badge-count {
        background-color: var(--mokka-brown, #A66A38);
        color: white;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.2rem;
    }

    .cart-total-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.8;
    }

    .cart-total-value {
        font-size: 1.4rem;
        font-weight: 800;
        line-height: 1;
    }

    .btn-checkout {
        background-color: #FFFFFF;
        color: var(--mokka-green-dark, #2E3E26) !important;
        font-weight: 800;
        font-size: 1.1rem;
        border-radius: 16px;
        padding: 0.8rem 1.8rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .custom-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(5px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .custom-modal-card {
        background: #FFFFFF;
        border-radius: 28px;
        width: 90%;
        max-width: 650px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 0;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        position: relative;
        animation: popModal 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes popModal {
        from { transform: scale(0.85); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .modal-img-header {
        width: 100%;
        height: 230px;
        object-fit: cover;
    }

    .btn-close-modal {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(255, 255, 255, 0.9);
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .custom-option-item {
        background-color: #FAF7F4;
        border: 1px solid rgba(113, 137, 104, 0.15);
        border-radius: 14px;
        padding: 0.8rem 1rem;
        margin-bottom: 0.6rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-qty-modal {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: 1px solid #D6CEC7;
        background-color: #FFFFFF;
        font-weight: 800;
        font-size: 1.2rem;
        cursor: pointer;
    }
</style>

<div class="catalog-wrapper mt-3">
    
