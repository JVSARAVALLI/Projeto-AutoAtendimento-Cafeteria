            <i class="bi bi-cup-hot-fill"></i> Cafés Quentes
        </button>
        <button class="btn-category" onclick="filterCategory('gelados', event)">
            <i class="bi bi-cup-straw"></i> Bebidas Geladas
        </button>
        <button class="btn-category" onclick="filterCategory('salgados', event)">
            <i class="bi bi-egg-fried"></i> Salgados
        </button>
        <button class="btn-category" onclick="filterCategory('sobremesas', event)">
            <i class="bi bi-cake2-fill"></i> Sobremesas
        </button>
    </div>

