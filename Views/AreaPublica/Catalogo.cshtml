@model List<Projeto_do_semestre.Models.Produto>
@{
    Layout = "_Layout_Publico";
    ViewData["Title"] = "Cardápio - Mokka Café";
}

<style>
    .catalog-wrapper {
        padding-bottom: 120px;
    }

    .catalog-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-weight: 800;
        color: var(--mokka-green-dark, #2E3E26);
        font-size: 2.2rem;
        letter-spacing: -0.5px;
        margin-bottom: 0.25rem;
    }

    .section-subtitle {
        color: var(--mokka-brown, #A66A38);
        font-size: 1.05rem;
        font-weight: 600;
    }

    .categories-scroll {
        display: flex;
        gap: 0.75rem;
        overflow-x: auto;
        padding: 0.5rem 0 1.5rem 0;
        scrollbar-width: none;
    }

        .categories-scroll::-webkit-scrollbar {
            display: none;
        }

    .btn-category {
        background-color: #FAF7F4;
        color: var(--mokka-brown-dark, #3E2012);
        border: 2px solid rgba(113, 137, 104, 0.2);
        border-radius: 50px;
        padding: 0.6rem 1.4rem;
        font-weight: 700;
        font-size: 0.95rem;
        white-space: nowrap;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

        .btn-category.active, .btn-category:hover {
            background-color: var(--mokka-green-dark, #2E3E26);
            color: #ffffff;
            border-color: var(--mokka-green-dark, #2E3E26);
            box-shadow: 0 4px 12px rgba(46, 62, 38, 0.2);
        }

    .card-coffee {
        border: 2px solid rgba(113, 137, 104, 0.15) !important;
        border-radius: 24px !important;
        box-shadow: 0 8px 24px rgba(46, 62, 38, 0.06) !important;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        background-color: #FFFFFF !important;
        overflow: hidden;
        cursor: pointer;
    }

        .card-coffee:hover {
            transform: translateY(-8px);
            box-shadow: 0 16px 32px rgba(46, 62, 38, 0.14) !important;
            border-color: var(--mokka-green, #718968) !important;
        }

    .card-img-container {
        position: relative;
        height: 190px;
        overflow: hidden;
    }

    .card-img-top {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .card-coffee:hover .card-img-top {
        transform: scale(1.05);
    }

    .badge-category {
        position: absolute;
        top: 12px;
        right: 12px;
        background-color: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(4px);
        color: var(--mokka-green-dark, #2E3E26);
        font-weight: 800;
        font-size: 0.75rem;
        border-radius: 30px;
        padding: 6px 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .card-title {
        color: var(--mokka-green-dark, #2E3E26);
        font-size: 1.2rem;
        font-weight: 800;
    }

    .price-tag {
        color: var(--mokka-brown-dark, #3E2012);
        font-size: 1.4rem;
        font-weight: 800;
    }

    .btn-add {
        background: linear-gradient(135deg, var(--mokka-brown, #A66A38) 0%, var(--mokka-brown-dark, #3E2012) 100%);
        color: #ffffff !important;
        font-weight: 700;
        border: none !important;
        border-radius: 14px !important;
        padding: 10px 18px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(166, 106, 56, 0.25);
    }

    .floating-cart-bar {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: 92%;
        max-width: 900px;
        background: var(--mokka-green-dark, #2E3E26);
        color: #ffffff;
        border-radius: 24px;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 12px 32px rgba(46, 62, 38, 0.35);
        z-index: 1000;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .cart-info {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .cart-badge-count {
        background-color: var(--mokka-brown, #A66A38);
        color: white;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.2rem;
    }

    .cart-total-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: 0.8;
    }

    .cart-total-value {
        font-size: 1.4rem;
        font-weight: 800;
        line-height: 1;
    }

    .btn-checkout {
        background-color: #FFFFFF;
        color: var(--mokka-green-dark, #2E3E26) !important;
        font-weight: 800;
        font-size: 1.1rem;
        border-radius: 16px;
        padding: 0.8rem 1.8rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .custom-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(5px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .custom-modal-card {
        background: #FFFFFF;
        border-radius: 28px;
        width: 90%;
        max-width: 650px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 0;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        position: relative;
        animation: popModal 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes popModal {
        from {
            transform: scale(0.85);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-img-header {
        width: 100%;
        height: 230px;
        object-fit: cover;
    }

    .btn-close-modal {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(255, 255, 255, 0.9);
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .custom-option-item {
        background-color: #FAF7F4;
        border: 1px solid rgba(113, 137, 104, 0.15);
        border-radius: 14px;
        padding: 0.8rem 1rem;
        margin-bottom: 0.6rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-qty-modal {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        border: 1px solid #D6CEC7;
        background-color: #FFFFFF;
        font-weight: 800;
        font-size: 1.2rem;
        cursor: pointer;
    }
</style>

<div class="catalog-wrapper mt-3">

    <div class="catalog-header">
        <h2 class="section-title">Nosso Cardápio</h2>
        <p class="section-subtitle">Toque em qualquer item para personalizar o seu pedido</p>
    </div>

    <!-- Categorias -->
    <div class="categories-scroll mb-4">
        <button class="btn-category active" onclick="filterCategory('todos', event)">
            <i class="bi bi-grid-fill"></i> Todos
        </button>
        <button class="btn-category" onclick="filterCategory('combos', event)">
            <i class="bi bi-stars"></i> Combos
        </button>
        <button class="btn-category" onclick="filterCategory('quentes', event)">
            <i class="bi bi-cup-hot-fill"></i> Cafés Quentes
        </button>
        <button class="btn-category" onclick="filterCategory('gelados', event)">
            <i class="bi bi-cup-straw"></i> Bebidas Geladas
        </button>
        <button class="btn-category" onclick="filterCategory('salgados', event)">
            <i class="bi bi-egg-fried"></i> Salgados
        </button>
        <button class="btn-category" onclick="filterCategory('sobremesas', event)">
            <i class="bi bi-cake2-fill"></i> Sobremesas
        </button>
    </div>

    <!-- Grid de Produtos -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @{
            var produtosDisponiveis = Model?
            .Where(p => p.Disponivel)
            .ToList() ?? new List<Projeto_do_semestre.Models.Produto>();
        }

        @if (produtosDisponiveis.Any())
        {
            @foreach (var produto in produtosDisponiveis)
            {
                var classeCategoria = produto.Categoria switch
                {
                    "Combos" => "combos",
                    "Cafés Quentes" => "quentes",
                    "Bebidas Geladas" => "gelados",
                    "Salgados" => "salgados",
                    "Sobremesas" => "sobremesas",
                    _ => "outros"
                };

                var tipoProduto = produto.Categoria switch
                {
                    "Combos" => "combo",
                    "Cafés Quentes" => "bebida",
                    "Bebidas Geladas" => "bebida",
                    "Salgados" => "comida",
                    "Sobremesas" => "sobremesa",
                    _ => "comida"
                };

                var nomeCategoria = produto.Categoria switch
                {
                    "Combos" => "Combo",
                    "Cafés Quentes" => "Quente",
                    "Bebidas Geladas" => "Gelado",
                    "Salgados" => "Salgado",
                    "Sobremesas" => "Sobremesa",
                    _ => produto.Categoria
                };

                var informacaoNutricional =
                string.IsNullOrWhiteSpace(produto.Descricao)
                ? "Informações nutricionais não cadastradas."
                : produto.Descricao;

                var imagemProduto = produto.Imagem ?? string.Empty;

                <div class="col product-item @classeCategoria">

                    <div class="card card-coffee h-100"
                         data-id="@produto.IdProduto"
                         data-nome="@produto.Nome"
                         data-preco="@produto.PrecoAtual.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                         data-descricao="Consulte a tabela nutricional deste produto."
                         data-imagem="@imagemProduto"
                         data-nutri="@informacaoNutricional"
                         data-tipo="@tipoProduto"
                         onclick="openCustomizeModal(
                                     this.dataset.id,
                                     this.dataset.nome,
                                     Number(this.dataset.preco),
                                     this.dataset.descricao,
                                     this.dataset.imagem,
                                     this.dataset.nutri,
                                     this.dataset.tipo
                                 )">

                        <div class="card-img-container">

                            @if (!string.IsNullOrWhiteSpace(imagemProduto))
                            {
                                <img src="@imagemProduto"
                                     class="card-img-top"
                                     alt="@produto.Nome">
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100">
                                    <span class="text-muted">Imagem não cadastrada</span>
                                </div>
                            }

                            <span class="badge-category">@nomeCategoria</span>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title mb-2">@produto.Nome</h5>

                            <p class="card-text text-muted fs-6 mb-3">
                                Consulte as informações nutricionais ao personalizar o produto.
                            </p>

                            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                                <span class="price-tag">
                                    @produto.PrecoAtual.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                                </span>

                                <button type="button" class="btn btn-add">
                                    <span>Personalizar</span>
                                    <i class="bi bi-sliders"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h5 class="text-muted">Nenhum produto disponível no momento.</h5>
            </div>
        }

    </div>

    <!-- BARRA FLUTUANTE DE CHECKOUT -->
    <div class="floating-cart-bar">
        <div class="cart-info">
            <div class="cart-badge-count" id="cartCount">0</div>
            <div>
                <div class="cart-total-label">Total do Pedido</div>
                <div class="cart-total-value" id="cartTotal">R$ 0,00</div>
            </div>
        </div>
        <a asp-controller="Pedido" asp-action="Carrinho" class="btn-checkout">
            <span>Ver Pedido</span>
            <i class="bi bi-arrow-right-circle-fill"></i>
        </a>
    </div>

    <!-- MODAL DINÂMICO DE CUSTOMIZAÇÃO -->
    <div class="custom-modal-overlay" id="customizeModalOverlay">
        <div class="custom-modal-card">
            <button type="button" class="btn-close-modal" onclick="closeCustomizeModal()">
                <i class="bi bi-x-lg"></i>
            </button>

            <img id="modalImg" src="" class="modal-img-header" alt="Produto">

            <div class="p-4">
                <h3 class="fw-bold mb-1" id="modalTitle" style="color: var(--mokka-green-dark, #2E3E26);">Nome do Produto</h3>
                <p class="text-muted fs-6 mb-2" id="modalDescription">Descrição do produto vai aqui...</p>

                <div class="badge bg-light text-dark border p-2 mb-4 fs-6 rounded-3" id="modalNutricional">
                    <i class="bi bi-info-circle text-primary me-1"></i> Info: 120 kcal
                </div>

                <!-- OPÇÕES DINÂMICAS -->
                <div id="customizeOptionsSection">
                    <h5 class="fw-bold mb-3" style="color: var(--mokka-brown-dark, #3E2012);">Personalize o seu pedido</h5>

                    <div id="optionsForDrinks" style="display: none;">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small text-uppercase">Deseja remover algo?</label>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="removeSugar">Sem Açúcar / Adoçante</label>
                                <input class="form-check-input" type="checkbox" id="removeSugar">
                            </div>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="removeCacao">Sem Cacau / Canela em pó</label>
                                <input class="form-check-input" type="checkbox" id="removeCacao">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Adicionar Extras (Opcional)</label>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="addShot">Shot Extra de Expresso (+R$ 3,50)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="addShot" value="3.50" onchange="calculateModalTotal()">
                            </div>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="addChantilly">Chantilly Artesanal (+R$ 2,50)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="addChantilly" value="2.50" onchange="calculateModalTotal()">
                            </div>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="addOatMilk">Trocar Leite por Leite de Aveia (+R$ 2,00)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="addOatMilk" value="2.00" onchange="calculateModalTotal()">
                            </div>
                        </div>
                    </div>

                    <div id="optionsForFood" style="display: none;">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small text-uppercase">Preparo</label>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="serveWarm">Servir Quentinho (Aquecido)</label>
                                <input class="form-check-input" type="checkbox" id="serveWarm" checked>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Adicionar Acompanhamento</label>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="addExpressoOption">Adicionar Expresso Tradicional (+R$ 6,50)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="addExpressoOption" value="6.50" onchange="calculateModalTotal()">
                            </div>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="addSodaOption">Adicionar Refrigerante / Suco (+R$ 7,50)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="addSodaOption" value="7.50" onchange="calculateModalTotal()">
                            </div>
                        </div>
                    </div>

                    <div id="optionsForDessert" style="display: none;">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Acompanhamentos Especiais</label>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="addIceCream">Bola de Sorvete de Baunilha (+R$ 5,00)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="addIceCream" value="5.00" onchange="calculateModalTotal()">
                            </div>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="addExtraSyrup">Calda Extra de Chocolate / Caramelo (+R$ 3,00)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="addExtraSyrup" value="3.00" onchange="calculateModalTotal()">
                            </div>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="addCoffeeSide">Expresso Acompanhante (+R$ 6,50)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="addCoffeeSide" value="6.50" onchange="calculateModalTotal()">
                            </div>
                        </div>
                    </div>

                    <div id="optionsForCombos" style="display: none;">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small text-uppercase">Opções do Combo</label>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="upgradeDrink">Upgrade para Bebida Grande (+R$ 4,00)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="upgradeDrink" value="4.00" onchange="calculateModalTotal()">
                            </div>
                            <div class="form-check custom-option-item">
                                <label class="form-check-label fw-semibold" for="addExtraSauce">Adicionar Geléia / Manteiga Extra (+R$ 2,50)</label>
                                <input class="form-check-input extra-option" type="checkbox" id="addExtraSauce" value="2.50" onchange="calculateModalTotal()">
                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex align-items-center justify-content-between gap-3 pt-3 border-top">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn-qty-modal" onclick="changeModalQty(-1)">-</button>
                        <span class="fw-bold fs-4 px-2" id="modalQty">1</span>
                        <button class="btn-qty-modal" onclick="changeModalQty(1)">+</button>
                    </div>

                    <button class="btn btn-success flex-grow-1 py-3 fw-bold rounded-4 fs-5" onclick="confirmAddToCart()" style="background-color: var(--mokka-green-dark, #2E3E26); border: none;">
                        Adicionar • <span id="modalTotalPrice">R$ 0,00</span>
                    </button>
                </div>
            </div>

        </div>
    </div>

    <script>
        let currentItem = {
            name: '',
            basePrice: 0.00,
            image: '',
            quantity: 1,
            type: 'bebida'
        };

        function openCustomizeModal(id, nome, preco, descricao, imagem, nutri, type) {
            currentItem.id = id;
            currentItem.name = nome;
            currentItem.basePrice = preco;
            currentItem.image = imagem;
            currentItem.quantity = 1;
            currentItem.type = type;

            document.getElementById('modalTitle').innerText = nome;
            document.getElementById('modalDescription').innerText = descricao;
            document.getElementById('modalImg').src = imagem;
            document.getElementById('modalNutricional').innerHTML = `<i class="bi bi-info-circle text-primary me-1"></i> ${nutri}`;
            document.getElementById('modalQty').innerText = '1';

            document.querySelectorAll('.form-check-input').forEach(chk => chk.checked = false);

            document.getElementById('optionsForDrinks').style.display = 'none';
            document.getElementById('optionsForFood').style.display = 'none';
            document.getElementById('optionsForDessert').style.display = 'none';
            document.getElementById('optionsForCombos').style.display = 'none';

            if (type === 'bebida') {
                document.getElementById('optionsForDrinks').style.display = 'block';
            } else if (type === 'comida') {
                document.getElementById('optionsForFood').style.display = 'block';
                document.getElementById('serveWarm').checked = true;
            } else if (type === 'sobremesa') {
                document.getElementById('optionsForDessert').style.display = 'block';
            } else if (type === 'combo') {
                document.getElementById('optionsForCombos').style.display = 'block';
            }

            calculateModalTotal();
            document.getElementById('customizeModalOverlay').style.display = 'flex';
        }

        function closeCustomizeModal() {
            document.getElementById('customizeModalOverlay').style.display = 'none';
        }

        function changeModalQty(delta) {
            currentItem.quantity += delta;
            if (currentItem.quantity < 1) currentItem.quantity = 1;
            document.getElementById('modalQty').innerText = currentItem.quantity;
            calculateModalTotal();
        }

        function calculateModalTotal() {
            let totalPerUnit = currentItem.basePrice;

            document.querySelectorAll('.extra-option:checked').forEach(chk => {
                totalPerUnit += parseFloat(chk.value);
            });

            const finalTotal = totalPerUnit * currentItem.quantity;
            document.getElementById('modalTotalPrice').innerText = 'R$ ' + finalTotal.toFixed(2).replace('.', ',');
        }


        async function confirmAddToCart() {
            let finalPriceUnit = currentItem.basePrice;
            let obs = [];

            // PERSONALIZAÇÕES DE BEBIDAS
            if (currentItem.type === 'bebida') {
                if (document.getElementById('removeSugar').checked)
                    obs.push("Sem Açúcar");

                if (document.getElementById('removeCacao').checked)
                    obs.push("Sem Cacau");

                if (document.getElementById('addShot').checked) {
                    obs.push("+Shot Expresso");
                    finalPriceUnit += 3.50;
                }

                if (document.getElementById('addChantilly').checked) {
                    obs.push("+Chantilly");
                    finalPriceUnit += 2.50;
                }

                if (document.getElementById('addOatMilk').checked) {
                    obs.push("+Leite Aveia");
                    finalPriceUnit += 2.00;
                }
            }

            // PERSONALIZAÇÕES DE COMIDAS
            else if (currentItem.type === 'comida') {
                if (document.getElementById('serveWarm').checked)
                    obs.push("Aquecido");

                if (document.getElementById('addExpressoOption').checked) {
                    obs.push("+Expresso");
                    finalPriceUnit += 6.50;
                }

                if (document.getElementById('addSodaOption').checked) {
                    obs.push("+Bebida");
                    finalPriceUnit += 7.50;
                }
            }

            // PERSONALIZAÇÕES DE SOBREMESAS
            else if (currentItem.type === 'sobremesa') {
                if (document.getElementById('addIceCream').checked) {
                    obs.push("+Sorvete");
                    finalPriceUnit += 5.00;
                }

                if (document.getElementById('addExtraSyrup').checked) {
                    obs.push("+Calda Extra");
                    finalPriceUnit += 3.00;
                }

                if (document.getElementById('addCoffeeSide').checked) {
                    obs.push("+Expresso");
                    finalPriceUnit += 6.50;
                }
            }

            // PERSONALIZAÇÕES DE COMBOS
            else if (currentItem.type === 'combo') {
                if (document.getElementById('upgradeDrink').checked) {
                    obs.push("+Bebida Grande");
                    finalPriceUnit += 4.00;
                }

                if (document.getElementById('addExtraSauce').checked) {
                    obs.push("+Geleia/Manteiga");
                    finalPriceUnit += 2.50;
                }
            }

            // ORGANIZA AS OBSERVAÇÕES
            const observacoes = obs.join(', ');

            // PREPARA OS DADOS PARA ENVIAR AO CONTROLLER
            const dados = new URLSearchParams();

            dados.append("idProduto", currentItem.id);
            dados.append("quantidade", currentItem.quantity);
            dados.append("observacao", observacoes);

            // Envia o preço com ponto decimal, conforme o PedidoController
            dados.append("precoUnitario", finalPriceUnit.toFixed(2));

            try {
                const resposta = await fetch("/Pedido/AdicionarAoCarrinho", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    body: dados
                });

                if (!resposta.ok) {
                    alert("Não foi possível adicionar o produto ao carrinho.");
                    return;
                }

                // Fecha a janela de personalização
                closeCustomizeModal();

                // Abre o carrinho com os produtos da Session
                window.location.href = "/Pedido/Carrinho";
            }
            catch (erro) {
                console.error("Erro ao adicionar produto:", erro);
                alert("Ocorreu um erro ao adicionar o produto ao carrinho.");
            }
        }


        async function updateFloatingBar() {
            const countBadge = document.getElementById('cartCount');
            const totalText = document.getElementById('cartTotal');
            const floatingBar = document.querySelector('.floating-cart-bar');

            try {
                const resposta = await fetch("/Pedido/ResumoCarrinho");

                if (!resposta.ok) {
                    throw new Error("Não foi possível consultar o carrinho.");
                }

                const resumo = await resposta.json();

                countBadge.innerText = resumo.quantidadeItens;
                totalText.innerText =
                    'R$ ' + Number(resumo.valorTotal).toFixed(2).replace('.', ',');

                // Esconde a barra quando o carrinho estiver vazio
                floatingBar.style.display =
                    resumo.quantidadeItens > 0 ? 'flex' : 'none';
            }
            catch (erro) {
                console.error("Erro ao atualizar a barra do carrinho:", erro);
            }
        }

        function filterCategory(category, evt) {
            const buttons = document.querySelectorAll('.btn-category');
            buttons.forEach(btn => btn.classList.remove('active'));
            if (evt) evt.currentTarget.classList.add('active');

            const items = document.querySelectorAll('.product-item');
            items.forEach(item => {
                if (category === 'todos' || item.classList.contains(category)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', updateFloatingBar);
    </script>
