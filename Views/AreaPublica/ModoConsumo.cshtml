@{
    Layout = "_Layout_Publico";
    ViewData["Title"] = "Modo de Consumo - Mokka Café";
}

<style>
    .consumption-section {
        max-width: 860px;
        margin: 4rem auto;
        padding: 0 1.5rem;
        text-align: center;
    }

    .consumption-title {
        color: var(--mokka-green-dark, #2E3E26);
        font-weight: 800;
        font-size: 2.2rem;
        letter-spacing: -0.5px;
        margin-bottom: 0.5rem;
    }

    .consumption-subtitle {
        color: var(--mokka-brown, #A66A38);
        font-size: 1.05rem;
        font-weight: 600;
        margin-bottom: 3rem;
    }

    .card-consumption-option {
        background-color: #FFFFFF;
        border: 2px solid rgba(113, 137, 104, 0.18);
        border-radius: 24px;
        padding: 3rem 2rem;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        transition: all 0.25s ease;
        box-shadow: 0 8px 24px rgba(46, 62, 38, 0.05);
    }

    .card-consumption-option:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 32px rgba(46, 62, 38, 0.12);
        border-color: var(--mokka-green, #718968);
    }

    .consumption-icon-box {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        margin-bottom: 1.5rem;
        background-color: #E8EFE6;
        color: var(--mokka-green-dark, #2E3E26);
    }

    .consumption-card-title {
        font-weight: 800;
        font-size: 1.4rem;
        color: var(--mokka-green-dark, #2E3E26);
        margin-bottom: 0.5rem;
    }

    .consumption-card-text {
        color: #6C757D;
        font-size: 0.92rem;
        font-weight: 600;
        margin: 0;
    }
</style>

<div class="consumption-section">
    <h2 class="consumption-title">Onde vai consumir?</h2>
    <p class="consumption-subtitle">Selecione o destino do seu pedido para preparar-mos da melhor forma</p>

    <div class="row g-4 justify-content-center">
        <!-- COMER AQUI -->
        <div class="col-12 col-md-5">
            <a asp-controller="AreaPublica" asp-action="Catalogo" class="card-consumption-option">
                <div class="consumption-icon-box">
                    <i class="bi bi-cup-hot-fill"></i>
                </div>
                <h3 class="consumption-card-title">Comer Aqui</h3>
                <p class="consumption-card-text">O seu pedido será servido numa bandeja para consumo no local.</p>
            </a>
        </div>

        <!-- PARA LEVAR -->
        <div class="col-12 col-md-5">
            <a asp-controller="AreaPublica" asp-action="Catalogo" class="card-consumption-option">
                <div class="consumption-icon-box">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
                <h3 class="consumption-card-title">Para Levar</h3>
                <p class="consumption-card-text">Embalagem especial preparada para viagem.</p>
            </a>
        </div>
    </div>
</div>