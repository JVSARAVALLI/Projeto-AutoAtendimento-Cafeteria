<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mokka Café (Cozinha)</title>

    <!-- CSS Padrão do ASP.NET (Bootstrap local) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Bootstrap Icons (Para os ícones do menu e das telas) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        /* Ajuste simples para garantir que o rodapé fique no fundo */
        html,
        body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        .flex-wrapper {
            flex: 1 0 auto;
        }
    </style>
</head>
<body>
    <div class="flex-wrapper">
        <!-- MENU SUPERIOR -->
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow mb-4">
                <div class="container-fluid">
                    <a class="navbar-brand text-warning" asp-controller="AreaCozinha" asp-action="CozIndex">
                        <i class="bi bi-cup-hot-fill"></i> Mokka Café | Cozinha
                    </a>
                    
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        
                        <!-- LINKS DAS TELAS DA COZINHA (Funcionários e Vendas removidos) -->
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="AreaCozinha" asp-action="CozIndex">
                                    <i class="bi bi-house-door"></i> Início
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="AreaCozinha" asp-action="CozCatalogo">
                                    <i class="bi bi-book"></i> Catálogo
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="AreaCozinha" asp-action="CozInsumos">
                                    <i class="bi bi-box-seam"></i> Insumos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="AreaCozinha" asp-action="CozCompras">
                                    <i class="bi bi-cart-check"></i> Compras
                                </a>
                            </li>
                        </ul>

                        <!-- BOTÃO DE SAIR (Código limpo e ação ajustada) -->
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="AreaPublica" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Sair
                                </a>
                            </li>
                        </ul>
                        
                    </div>
                </div>
            </nav>
        </header>

        <!-- ÁREA ONDE AS VIEWS SERÃO RENDERIZADAS -->
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- RODAPÉ -->
    <footer class="border-top footer text-muted bg-light py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - Mokka Café - Sistema de Gestão da Cozinha
        </div>
    </footer>

    <!-- SCRIPTS PADRÃO DO ASP.NET -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>