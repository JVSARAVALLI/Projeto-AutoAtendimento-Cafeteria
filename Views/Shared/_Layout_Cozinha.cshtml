<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mokka Café (Cozinha)</title>

    <!-- CSS Padrão do ASP.NET (Bootstrap local) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --mokka-green-dark: #2E3E26;
            --mokka-green: #718968;
            --mokka-green-light: #E8EFE6;
            --mokka-brown: #A66A38;
            --mokka-brown-dark: #3E2012;
            --mokka-bg: #FAF7F4;
        }

        html,
        body {
            height: 100%;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: var(--mokka-bg);
            color: #2D312E;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        .flex-wrapper {
            flex: 1 0 auto;
        }

        /* NAVBAR COM IDENTIDADE VISUAL MOKKA CAFÉ */
        .mokka-navbar-kitchen {
            background-color: var(--mokka-green-dark) !important;
            padding: 0.85rem 1.5rem;
            box-shadow: 0 4px 16px rgba(46, 62, 38, 0.25);
        }

        .mokka-brand {
            color: #FFFFFF !important;
            font-weight: 800;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
        }

        .mokka-brand i {
            color: var(--mokka-brown);
            font-size: 1.35rem;
        }

        .kitchen-badge-tag {
            background-color: var(--mokka-brown);
            color: #FFFFFF;
            font-size: 0.72rem;
            font-weight: 800;
            padding: 3px 9px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .nav-mokka-link {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 600;
            font-size: 0.92rem;
            padding: 0.5rem 0.85rem !important;
            border-radius: 12px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .nav-mokka-link:hover, 
        .nav-mokka-link.active {
            color: #FFFFFF !important;
            background-color: rgba(255, 255, 255, 0.12);
        }

        .btn-mokka-logout {
            color: #FFB3B3 !important;
            font-weight: 700;
            font-size: 0.9rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.5rem 0.9rem;
            border-radius: 12px;
            transition: background-color 0.2s ease;
        }

        .btn-mokka-logout:hover {
            background-color: rgba(255, 77, 77, 0.18);
            color: #FF8080 !important;
        }

        .mokka-footer {
            background-color: #FFFFFF !important;
            border-top: 1px solid rgba(113, 137, 104, 0.15) !important;
            color: #6C757D;
            font-size: 0.88rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="flex-wrapper">
        <!-- MENU SUPERIOR REFORMULADO -->
        <header>
            <nav class="navbar navbar-expand-lg mokka-navbar-kitchen mb-4">
                <div class="container-fluid">
                    <a class="mokka-brand me-3" asp-controller="AreaCozinha" asp-action="CozIndex">
                        <i class="bi bi-cup-hot-fill"></i>
                        <span>Mokka Café</span>
                        <span class="kitchen-badge-tag">Cozinha</span>
                    </a>

                    <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mokkaKitchenNavbar" aria-controls="mokkaKitchenNavbar" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <i class="bi bi-list fs-2 text-white"></i>
                    </button>

                    <div class="collapse navbar-collapse" id="mokkaKitchenNavbar">
                        <!-- LINKS DAS TELAS DA COZINHA -->
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                            <li class="nav-item">
                                <a class="nav-mokka-link" asp-controller="AreaCozinha" asp-action="CozIndex">
                                    <i class="bi bi-house-door-fill"></i> Início
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-mokka-link" asp-controller="AreaCozinha" asp-action="CozCatalogo">
                                    <i class="bi bi-book-fill"></i> Catálogo
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-mokka-link" asp-controller="AreaCozinha" asp-action="CozInsumos">
                                    <i class="bi bi-box-seam-fill"></i> Insumos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-mokka-link" asp-controller="AreaCozinha" asp-action="CozFuncionarios">
                                    <i class="bi bi-people-fill"></i> Funcionários
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-mokka-link" asp-controller="AreaCozinha" asp-action="CozCompras">
                                    <i class="bi bi-cart-check-fill"></i> Compras
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-mokka-link" asp-controller="AreaCozinha" asp-action="CozDashboard">
                                    <i class="bi bi-graph-up-arrow"></i> Vendas
                                </a>
                            </li>
                        </ul>

                        <!-- BOTÃO DE SAIR CORRIGIDO E ALINHADO -->
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="btn-mokka-logout" asp-controller="AreaPublica" asp-action="Login">
                                    <i class="bi bi-box-arrow-right fs-5"></i> Sair
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <!-- ÁREA ONDE AS VIEWS SERÃO RENDERIZADAS -->
        <div class="container-fluid px-lg-5">
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- RODAPÉ -->
    <footer class="mokka-footer py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - Mokka Café - Sistema de Gestão da Cozinha
        </div>
    </footer>

    <!-- SCRIPTS PADRÃO DO ASP.NET -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>