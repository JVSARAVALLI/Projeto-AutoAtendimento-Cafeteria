<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mokka Café</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --mokka-green-dark: #2E3E26;
            --mokka-green: #718968;
            --mokka-brown-dark: #3E2012;
            --mokka-brown: #A66A38;
            --mokka-bg: #FAF7F4;
            --mokka-card: #FFFFFF;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--mokka-bg);
            color: var(--mokka-brown-dark);
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Navbar estilo Totem */
        .mokka-navbar {
            background-color: var(--mokka-green-dark);
            padding: 0.8rem 1.5rem;
            box-shadow: 0 4px 12px rgba(46, 62, 38, 0.15);
        }

        .mokka-brand {
            color: #ffffff !important;
            font-weight: 800;
            font-size: 1.4rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .mokka-nav-link {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 700;
            padding: 0.5rem 1rem !important;
            border-radius: 12px;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .mokka-nav-link:hover, .mokka-nav-link.active {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.12);
        }

        .btn-acesso-interno {
            background-color: rgba(255, 255, 255, 0.15);
            color: #ffffff !important;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 12px;
            padding: 0.4rem 0.9rem;
            font-size: 0.85rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-acesso-interno:hover {
            background-color: rgba(255, 255, 255, 0.25);
            color: #ffffff !important;
        }

        main {
            flex: 1;
        }
    </style>
</head>
<body>

    @{
        // Oculta a barra de navegação superior apenas na tela inicial do Totem
        string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        bool isIndexPublico = currentAction.Equals("IndexPublico", StringComparison.OrdinalIgnoreCase);
    }

    @if (!isIndexPublico)
    {
        <header>
            <nav class="navbar navbar-expand-lg mokka-navbar">
                <div class="container-fluid max-width-1200">
                    <a class="mokka-brand" asp-controller="AreaPublica" asp-action="IndexPublico">
                        <i class="bi bi-cup-hot-fill"></i>
                        <span>Mokka Café</span>
                    </a>

                    <div class="d-flex align-items-center gap-2">
                        <a class="mokka-nav-link" asp-controller="AreaPublica" asp-action="Catalogo">Cardápio</a>
                        <a class="mokka-nav-link" asp-controller="AreaPublica" asp-action="Opcoes">Opções</a>
                        <a class="mokka-nav-link" asp-controller="AreaPublica" asp-action="Identificacao">Fidelidade</a>
                        <a class="mokka-nav-link" asp-controller="AreaPublica" asp-action="Carrinho">
                            <i class="bi bi-cart3"></i> Carrinho
                        </a>
                        <a class="btn-acesso-interno ms-2" asp-controller="AreaPublica" asp-action="Login">
                            <i class="bi bi-lock-fill"></i> Acesso Interno
                        </a>
                    </div>
                </div>
            </nav>
        </header>
    }
    else
    {
        /* Na tela inicial do Totem, deixa apenas o botão discreto de Acesso Interno no topo */
        <div style="position: absolute; top: 20px; right: 20px; z-index: 1000;">
            <a class="btn-acesso-interno" asp-controller="AreaPublica" asp-action="Login" style="background-color: rgba(0,0,0,0.06); color: var(--mokka-brown-dark) !important; border-color: rgba(0,0,0,0.1);">
                <i class="bi bi-lock-fill"></i> Acesso Interno
            </a>
        </div>
    }

    <main role="main">
        <div class="@(isIndexPublico ? "" : "container py-4")">
            @RenderBody()
        </div>
    </main>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/bootstrap.bundle.min.js"></script>
</body>
</html>