<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Mokka Café</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            /* Paleta de cores Mokka CAFÉ */
            --mokka-green: #9ab07a;
            --mokka-green-dark: #7a8e5f;
            --mokka-brown: #aa7946;
            --mokka-brown-dark: #8c6035;
            --mokka-black: #1a1a1a;
            --mokka-bg: #f4f5f0; /* Fundo bem claro com leve tom de sálvia */
            --mokka-card: #fcfaf8; /* Fundo creme para os cartões */
        }

        body {
            background-color: var(--mokka-bg);
            color: var(--mokka-black);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding-bottom: 80px;
        }

        .navbar-custom {
            /* Navbar no tom verde escuro da marca */
            background-color: var(--mokka-green-dark);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

            .navbar-custom .navbar-brand {
                color: #fff;
                font-weight: 700;
                font-size: 1.5rem;
            }

            .navbar-custom .nav-link {
                color: rgba(255, 255, 255, 0.85);
                font-weight: 500;
                margin: 0 5px;
                border-radius: 8px;
                transition: all 0.3s;
            }

                .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active {
                    color: #fff;
                    background-color: var(--mokka-brown); /* Destaque em marrom */
                    font-weight: bold;
                }

        .section-title {
            font-weight: 800;
            color: var(--mokka-black);
            border-bottom: 3px solid var(--mokka-brown);
            display: inline-block;
            padding-bottom: 5px;
            margin-bottom: 30px;
            margin-top: 20px;
        }

        .card-coffee {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.06);
            transition: transform 0.3s ease;
            background-color: var(--mokka-card);
            overflow: hidden;
        }

            .card-coffee:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 20px rgba(0,0,0,0.12);
            }

        .card-img-top {
            height: 220px;
            object-fit: cover;
        }

        .price-tag {
            color: var(--mokka-brown-dark);
            font-size: 1.4rem;
            font-weight: 800;
        }

        .btn-add {
            background-color: var(--mokka-brown);
            color: #fff;
            font-weight: 700;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            transition: background-color 0.2s;
        }

            .btn-add:hover {
                background-color: var(--mokka-brown-dark);
                color: #fff;
            }

        .nutricional-link {
            font-size: 0.8rem;
            color: #6c757d;
            text-decoration: underline;
            cursor: pointer;
        }

        .cart-floating {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background-color: var(--mokka-brown); /* Botão flutuante marrom */
            color: white;
            border-radius: 50px;
            padding: 15px 30px;
            display: flex;
            align-items: center;
            font-weight: bold;
            box-shadow: 0 6px 15px rgba(136, 96, 53, 0.4); /* Sombra marrom */
            z-index: 1000;
            cursor: pointer;
            transition: transform 0.2s;
        }

            .cart-floating:hover {
                transform: scale(1.05);
                background-color: var(--mokka-brown-dark);
            }

        .cart-badge {
            background-color: white;
            color: var(--mokka-brown-dark);
            border-radius: 50%;
            padding: 4px 10px;
            margin-left: 10px;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-custom sticky-top py-3">
        <div class="container">
            <!-- Texto atualizado para combinar com a marca -->
            <a class="navbar-brand" asp-controller="AreaPublica" asp-action="Index">☕ Mokka Café</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="AreaPublica" asp-action="IndexPublico">Home</a></li>
                    <li class="nav-item"><a class="nav-link active" asp-controller="AreaPublica" asp-action="Catalogo">Catálogo</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Opções</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Identificação</a></li>
                    <!-- Borda do carrinho ajustada para a cor da marca -->
                    <li class="nav-item"><a class="nav-link" style="border: 2px solid var(--mokka-brown);" asp-controller="AreaPublica" asp-action="Carrinho">🛒 Carrinho</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Injeção obrigatória do corpo da página -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <div class="cart-floating" title="Finalizar Pedido">
        Ver Pedido <span class="cart-badge">0</span>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>