<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mokka Café</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Projeto_do_semestre.styles.css" asp-append-version="true" />

    <style>
        .mokka-nav {
            background-color: #8c9c6c;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .mokka-logo {
            color: white;
            text-decoration: none;
            font-size: 1.8em;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .mokka-logo:hover {
                color: #f8f9fa;
            }

        .mokka-links {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .mokka-link {
            color: white;
            text-decoration: none;
            font-size: 1.1em;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 8px;
            transition: background-color 0.2s;
        }

            .mokka-link:hover {
                background-color: rgba(255,255,255,0.2);
                color: white;
            }

        .mokka-cart {
            border: 1px solid white;
            border-radius: 20px;
            padding: 8px 20px;
            margin-left: 10px;
        }
    </style>
</head>
<body style="background-color: #f4f6f8; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0;">

    <header>
        <nav class="mokka-nav">
            <!-- Logótipo -->
            <a href="/AreaPublica/IndexPublico" class="mokka-logo">
                <span style="font-size: 1.2em;">☕</span> Mokka Café
            </a>

            <!-- Links do Menu Superior (Identificação removida) -->
            <div class="mokka-links">
                <a href="/AreaPublica/IndexPublico" class="mokka-link">Home</a>
                <a href="/AreaPublica/Catalogo" class="mokka-link">Catálogo</a>
                <a href="/AreaPublica/Opcoes" class="mokka-link">Opções</a>
                <a href="/AreaPublica/Carrinho" class="mokka-link mokka-cart">🛒 Carrinho</a>
            </div>
        </nav>
    </header>

    <div style="width: 100%;">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>