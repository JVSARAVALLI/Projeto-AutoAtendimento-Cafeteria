<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Gestão Mokka Café</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Paleta de cores Mokka CAFÉ */
            --mokka-green-dark: #2E3E26;
            --mokka-green: #718968;
            --mokka-green-light: #E8EFE6;
            --mokka-brown: #A66A38;
            --mokka-brown-dark: #3E2012;
            --admin-bg: #FAF7F4;
        }

        html, body {
            height: 100%;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            background-color: var(--admin-bg);
            color: #2D312E;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        .flex-wrapper {
            flex: 1 0 auto;
        }

        /* NAVBAR SUPERIOR NO ESTILO DA COZINHA (VERDE ESCURO) */
        .mokka-navbar-admin {
            background-color: var(--mokka-green-dark) !important;
            padding: 0.85rem 1.5rem;
            box-shadow: 0 4px 16px rgba(46, 62, 38, 0.25);
        }

        .mokka-brand {
            color: #FFFFFF !important;
            font-weight: 800;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            text-decoration: none;
        }

        .mokka-brand i {
            color: var(--mokka-brown);
            font-size: 1.35rem;
        }

        /* BADGE DESTACADA DO ADMIN */
        .admin-badge-tag {
            background-color: var(--mokka-brown);
            color: #FFFFFF;
            font-size: 0.72rem;
            font-weight: 800;
            padding: 3px 10px;
            border-radius: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* LINKS NAVEGÁVEIS COM DESTAQUE DA PÁGINA ATIVA */
        .nav-mokka-link {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 600;
            font-size: 0.92rem;
            padding: 0.5rem 0.9rem !important;
            border-radius: 12px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            text-decoration: none;
        }

        .nav-mokka-link:hover, 
        .nav-mokka-link.active {
            color: #FFFFFF !important;
            background-color: rgba(255, 255, 255, 0.15);
            font-weight: 700;
        }

        /* BOTÃO SAIR NO CANTO DIREITO */
        .btn-mokka-logout {
            color: #FFB3B3 !important;
            font-weight: 700;
            font-size: 0.9rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.5rem 0.9rem;
            border-radius: 12px;
            transition: background-color 0.2s ease;
        }

        .btn-mokka-logout:hover {
            background-color: rgba(255, 77, 77, 0.18);
            color: #FF8080 !important;
        }

        .mokka-footer {
            background-color: #FFFFFF !important;
            border-top: 1px solid rgba(113, 137, 104, 0.15) !important;
            color: #6C757D;
            font-size: 0.88rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    @{
        // Captura a página atual para acender a aba no menu
        var actionAtual = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <div class="flex-wrapper">
        <!-- NAVBAR SUPERIOR DO ADMIN -->
        <header>
            <nav class="navbar navbar-expand-lg mokka-navbar-admin mb-4">
                <div class="container-fluid px-lg-4">
                    <a class="mokka-brand me-4" asp-controller="AreaRestrita" asp-action="AdmIndex">
                        <i class="bi bi-cup-hot-fill"></i>
                        <span>Mokka Café</span>
                        <span class="admin-badge-tag">ADMIN</span>
                    </a>

                    <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mokkaAdminNavbar" aria-controls="mokkaAdminNavbar" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <i class="bi bi-list fs-2 text-white"></i>
                    </button>

                    <div class="collapse navbar-collapse" id="mokkaAdminNavbar">
                        <!-- LINKS DAS TELAS DO ADMIN -->
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                            <li class="nav-item">
                                <a class="nav-mokka-link @(actionAtual == "AdmIndex" ? "active" : "")" 
                                   asp-controller="AreaRestrita" asp-action="AdmIndex">
                                    <i class="bi bi-house-door-fill"></i> <span>Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-mokka-link @(actionAtual == "AdmCadastros" ? "active" : "")" 
                                   asp-controller="AreaRestrita" asp-action="AdmCadastros">
                                    <i class="bi bi-plus-circle-fill"></i> <span>Cadastrar Produto</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-mokka-link @(actionAtual == "AdmCatalogo" ? "active" : "")" 
                                   asp-controller="AreaRestrita" asp-action="AdmCatalogo">
                                    <i class="bi bi-cup-hot-fill"></i> <span>Gerenciar Cardápio</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-mokka-link @(actionAtual == "AdmVendas" ? "active" : "")" 
                                   asp-controller="AreaRestrita" asp-action="AdmVendas">
                                    <i class="bi bi-receipt"></i> <span>Controle de Pedidos</span>
                                </a>
                            </li>
                        </ul>

                        <!-- BOTÃO DE SAIR -->
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="btn-mokka-logout" asp-controller="AreaPublica" asp-action="Login">
                                    <i class="bi bi-box-arrow-right fs-5"></i> Sair
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <!-- ÁREA ONDE AS VIEWS (EX: AdmIndex) SERÃO RENDERIZADAS -->
        <div class="container-fluid px-lg-5">
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- RODAPÉ -->
    <footer class="mokka-footer py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - Mokka Café - Painel de Gestão Administrativa
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>