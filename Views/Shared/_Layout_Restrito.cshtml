<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Gestão Mokka Café</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            /* Paleta de cores Mokka CAFÉ */
            --mokka-green: #9ab07a;
            --mokka-green-dark: #7a8e5f;
            --mokka-brown: #aa7946;
            --mokka-brown-dark: #8c6035;
            --mokka-black: #1a1a1a;
            --admin-bg: #f4f5f0;
        }

        body {
            background-color: var(--admin-bg);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
            color: var(--mokka-black);
        }

        .wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
            min-height: 100vh;
        }

        /* Menu Lateral - Estilo Admin Mokka */
        .sidebar {
            min-width: 250px;
            max-width: 250px;
            background-color: var(--mokka-black);
            color: #fff;
            transition: all 0.3s;
        }

            .sidebar .sidebar-header {
                padding: 20px;
                background-color: #0a0a0a;
                border-bottom: 1px solid #2a2a2a;
                text-align: center;
            }

            .sidebar ul.components {
                padding: 20px 0;
            }

            .sidebar ul li a {
                padding: 12px 20px;
                font-size: 1.05em;
                display: block;
                color: #e0e0e0;
                text-decoration: none;
                transition: 0.2s;
            }

                .sidebar ul li a:hover, .sidebar ul li.active > a {
                    color: #fff;
                    background: var(--mokka-green-dark);
                    font-weight: bold;
                    border-left: 4px solid var(--mokka-brown);
                }

                .sidebar ul li a i {
                    margin-right: 10px;
                }

        .content {
            width: 100%;
            padding: 25px;
            transition: all 0.3s;
        }

        .topbar {
            background: #fff;
            padding: 15px 25px;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(26, 26, 26, 0.05);
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 5px solid var(--mokka-green);
        }

        @@media (max-width: 768px) {
            .sidebar {
                min-width: 80px;
                max-width: 80px;
            }

                .sidebar .sidebar-header h4, .sidebar ul li a span {
                    display: none;
                }
        }
    </style>
</head>
<body>
    @{
        // Captura a página atual para acender a aba no menu lateral
        var actionAtual = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <div class="wrapper">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <h4 class="m-0 text-white fw-bold">☕ Mokka Café</h4>
            </div>
            <ul class="list-unstyled components">
                <li class="@(actionAtual == "AdmIndex" ? "active" : "")">
                    <a asp-controller="AreaRestrita" asp-action="AdmIndex"><i class="bi bi-house-door"></i> <span>Dashboard</span></a>
                </li>
                <li class="@(actionAtual == "AdmCadastros" ? "active" : "")">
                    <a asp-controller="AreaRestrita" asp-action="AdmCadastros"><i class="bi bi-plus-circle"></i> <span>Cadastrar Produto</span></a>
                </li>
                <li class="@(actionAtual == "AdmCatalogo" ? "active" : "")">
                    <a asp-controller="AreaRestrita" asp-action="AdmCatalogo"><i class="bi bi-cup-hot"></i> <span>Gerenciar Cardápio</span></a>
                </li>
                <li class="@(actionAtual == "AdmVendas" ? "active" : "")">
                    <a asp-controller="AreaRestrita" asp-action="AdmVendas"><i class="bi bi-receipt"></i> <span>Controle de Pedidos</span></a>
                </li>
            </ul>
        </nav>

        <!-- Conteúdo Principal -->
        <div class="content">
            <!-- Barra Superior -->
            <div class="topbar">
                <h5 class="m-0 fw-bold" style="color: var(--mokka-black);">Painel de Gestão da Cafeteria</h5>
                <div class="dropdown">
                    <button class="btn btn-light dropdown-toggle d-flex align-items-center border" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle fs-5 me-2" style="color: var(--mokka-brown-dark);"></i><span>Atendente</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item text-danger" asp-controller="AreaPublica" asp-action="Login"><i class="bi bi-box-arrow-right me-2"></i>Sair do Sistema</a></li>
                    </ul>
                </div>
            </div>

            <!-- Injeção do corpo da página -->
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>